msgstr ""

#: ../../../LangRef.md:25577
msgid "'`llvm.experimental.constrained.acos`' Intrinsic"
msgstr ""

#: ../../../LangRef.md:25590
msgid ""
"The '`llvm.experimental.constrained.acos`' intrinsic returns the arccosine "
