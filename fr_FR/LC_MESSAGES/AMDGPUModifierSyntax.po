msgid "wait_va_vdst"
msgstr ""

#: ../../../AMDGPUModifierSyntax.rst:1191
msgid ""
"Manually specify a wait on the VA_VDST counter before issuing this "
"instruction. VA_VDST must be less than or equal to this value before the "
"instruction is issued. If set to 15, no wait is performed."
msgstr ""

#: ../../../AMDGPUModifierSyntax.rst:1194
#: ../../../AMDGPUModifierSyntax.rst:1233
msgid ""
"If unspecified the current default is zero. This is a safe value but may "
"have poor performance characteristics."
msgstr ""

#: ../../../AMDGPUModifierSyntax.rst:1196
msgid ""
"This modifier is a shorthand for the WAR hazard where VALU reads a VGPR that "
"is written by a parameter load. Since there is no VA_VSRC counter we must "
"use VA_VDST as a proxy to detect when the VALU instruction has completed:"
msgstr ""

#: ../../../AMDGPUModifierSyntax.rst:1210
msgid "wait_vdst"
msgstr ""

#: ../../../AMDGPUModifierSyntax.rst:1212
msgid ""
"Specifies a wait on the VA_VDST counter before issuing the current "
"instruction. The counter must be less than or equal to this value before the "
"instruction is issued. If set to 15, no wait is performed."
msgstr ""

#: ../../../AMDGPUModifierSyntax.rst:1221
msgid "wait_vdst:{0..15}"
msgstr ""

#: ../../../AMDGPUModifierSyntax.rst:1221
msgid ""
"An additional wait on the VA_VDST counter before issuing this instruction."
msgstr ""

#: ../../../AMDGPUModifierSyntax.rst:1228
msgid "wait_vm_vsrc"
msgstr ""

