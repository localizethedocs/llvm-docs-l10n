msgid "Key Features"
msgstr ""

#: ../../../Instrumentor.md:33
msgid "Configurable Instrumentation Opportunities"
msgstr ""

#: ../../../Instrumentor.md:35
msgid "The Instrumentor supports instrumentation at multiple levels:"
msgstr ""

#: ../../../Instrumentor.md:37
msgid "**Instruction-level:**"
msgstr ""

#: ../../../Instrumentor.md:38
msgid ""
"**Load instructions**: Instrument memory reads with access to pointer, "
"loaded value, alignment, size, atomicity, etc."
msgstr ""

#: ../../../Instrumentor.md:39
msgid ""
"**Store instructions**: Instrument memory writes with access to pointer, "
"stored value, alignment, size, atomicity, etc."
msgstr ""

#: ../../../Instrumentor.md:40
msgid ""
"**Alloca instructions**: Instrument stack allocations with access to size, "
"alignment, and allocated address"
msgstr ""

#: ../../../Instrumentor.md:42
msgid "**Function-level:**"
msgstr ""

#: ../../../Instrumentor.md:43
msgid ""
"**Function entry**: Instrument at function start with access to function "
"name, address, arguments, etc."
msgstr ""

#: ../../../Instrumentor.md:44
msgid "**Function exit**: Instrument at function return"
msgstr ""

#: ../../../Instrumentor.md:46
msgid "**Future extensions:**"
msgstr ""

#: ../../../Instrumentor.md:47 ../../../Instrumentor.md:882
msgid "Basic block entry/exit"
msgstr ""

#: ../../../Instrumentor.md:48
msgid "Module-level initialization"
msgstr ""

#: ../../../Instrumentor.md:49 ../../../Instrumentor.md:888
msgid "Global variable access"
msgstr ""

#: ../../../Instrumentor.md:51
msgid "PRE and POST Instrumentation"
msgstr ""

#: ../../../Instrumentor.md:53
msgid "Each instrumentation opportunity supports two positions:"
msgstr ""

#: ../../../Instrumentor.md:55
msgid "**PRE**: Insert instrumentation **before** the operation occurs"
msgstr ""

#: ../../../Instrumentor.md:57
msgid "For loads: can inspect/modify the pointer before reading"
msgstr ""

#: ../../../Instrumentor.md:58
msgid "For stores: can inspect/modify the pointer and value before writing"
msgstr ""

#: ../../../Instrumentor.md:59
msgid "For allocas: can modify the allocation size"
msgstr ""

#: ../../../Instrumentor.md:60
msgid "For functions: instrument at function entry, inspect/replace arguments"
msgstr ""

#: ../../../Instrumentor.md:62
msgid "**POST**: Insert instrumentation **after** the operation occurs"
msgstr ""

#: ../../../Instrumentor.md:64
msgid "For loads: can inspect/modify the loaded value"
msgstr ""

#: ../../../Instrumentor.md:65
msgid "For stores: instrument after the write completes"
msgstr ""

#: ../../../Instrumentor.md:66
msgid "For allocas: can inspect/modify the allocated address"
msgstr ""

#: ../../../Instrumentor.md:67
msgid "For functions: instrument at function exit"
msgstr ""

