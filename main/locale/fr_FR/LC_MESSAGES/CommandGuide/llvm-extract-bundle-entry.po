#: ../../../CommandGuide/llvm-extract-bundle-entry.rst:2
msgid "llvm-extract-bundle-entry - extract an offload bundle entry"
msgstr ""

#: ../../../CommandGuide/llvm-extract-bundle-entry.rst:7
msgid "SYNOPSIS"
msgstr ""

#: ../../../CommandGuide/llvm-extract-bundle-entry.rst:9
msgid ":program:`llvm-extract-bundle-entry` [*options*] URI"
msgstr ""

#: ../../../CommandGuide/llvm-extract-bundle-entry.rst:12
msgid "DESCRIPTION"
msgstr ""

#: ../../../CommandGuide/llvm-extract-bundle-entry.rst:14
msgid ""
":program:`llvm-extract-offload-entry` is a tool thet takes a URI argument "
"and generates a code object file by extracting an offload bundle entry "
"specified by the URI given."
msgstr ""

#: ../../../CommandGuide/llvm-extract-bundle-entry.rst:18
msgid "The URI syntax is defined as:"
msgstr ""

#: ../../../CommandGuide/llvm-extract-bundle-entry.rst:27
msgid "-- code-block::bnf"
msgstr ""

#: ../../../CommandGuide/llvm-extract-bundle-entry.rst:21
msgid ""
"<code_object_uri> ::== <file_uri> | <memory_uri> <file_uri>        ::== "
"\"file://\"<extract_file><range_specifier> <memory_uri>      ::== \"memory://"
"\"<process_id><range_specifier> <range_specifier> ::== [ \"#\" | \"?"
"\" ]\"offset=\"<number>\"&size=\"<number> <extract_file>    ::== "
"URI_ENCODED_OS_FILE_PATH <process_id>      ::== DECIMAL_NUMBER "
"<number>          ::== DECIMAL_NUMBER"
msgstr ""

#: ../../../CommandGuide/llvm-extract-bundle-entry.rst:29
msgid ""
"The output is always written to a file, whose name is generated from the URI "
"input given."
msgstr ""

#: ../../../CommandGuide/llvm-extract-bundle-entry.rst:32
msgid "OPTIONS"
msgstr ""

#: ../../../CommandGuide/llvm-extract-bundle-entry.rst:34
msgid ""
"The following options are either agnostic of the file format or apply to "
"multiple file formats."
msgstr ""

#: ../../../CommandGuide/llvm-extract-bundle-entry.rst:39
msgid "Print a summary of command line options."
msgstr ""

#: ../../../CommandGuide/llvm-extract-bundle-entry.rst:43
msgid ""
"Write output to <file>. Multiple input files cannot be used in combination "
"with -o."
msgstr ""

#: ../../../CommandGuide/llvm-extract-bundle-entry.rst:48
msgid ""
"Display the version of the :program:`llvm-extract-bundle-entry` executable."
msgstr ""

#: ../../../CommandGuide/llvm-extract-bundle-entry.rst:51
msgid "EXIT STATUS"
msgstr ""

#: ../../../CommandGuide/llvm-extract-bundle-entry.rst:53
msgid ""
":program:`llvm-extract-bundle-entry` exits with a non-zero exit code if "
"there is an error. Otherwise, it exits with code 0."
msgstr ""

