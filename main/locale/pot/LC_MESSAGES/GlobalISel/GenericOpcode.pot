#: ../../../GlobalISel/GenericOpcode.md:78
msgid "Integer Extension and Truncation"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:80
msgid "G_ANYEXT"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:82
msgid ""
"Extend the underlying scalar type of an operation, leaving the high bits "
"unspecified."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:89
msgid "G_SEXT"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:91
msgid ""
"Sign extend the underlying scalar type of an operation, copying the sign bit "
"into the newly-created space."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:98
msgid "G_SEXT_INREG"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:100
msgid ""
"Sign extend the value from an arbitrary bit position, copying the sign bit "
"into all bits above it. This is equivalent to a shl + ashr pair with an "
"appropriate shift amount. \\$sz is an immediate (MachineOperand::isImm() "
"returns true) to allow targets to have some bitwidths legal and others "
"lowered. This opcode is particularly useful if the target has sign-extension "
"instructions that are cheaper than the constituent shifts as the optimizer "
"is able to make decisions on whether it's better to hang on to the "
"G_SEXT_INREG or to lower it and optimize the individual shifts."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:113
msgid "G_ZEXT"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:115
msgid ""
"Zero extend the underlying scalar type of an operation, putting zero bits "
"into the newly-created space."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:122
msgid "G_TRUNC"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:124
msgid ""
"Truncate the underlying scalar type of an operation. This is equivalent to "
"G_EXTRACT for scalar types, but acts elementwise on vectors."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:131
msgid "G_TRUNC_SSAT_S"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:133
msgid "Truncate a signed input to a signed result with saturation."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:139
msgid "G_TRUNC_SSAT_U"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:141
msgid "Truncate a signed input to an unsigned result with saturation."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:147
msgid "G_TRUNC_USAT_U"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:149
msgid "Truncate a unsigned input to an unsigned result with saturation."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:155
msgid "Type Conversions"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:157
msgid "G_INTTOPTR"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:159
msgid "Convert an integer to a pointer."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:165
msgid "G_PTRTOINT"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:167
msgid "Convert a pointer to an integer."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:173
msgid "G_BITCAST"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:175
msgid ""
"Reinterpret a value as a new type. This is usually done without changing any "
"bits but this is not always the case due a subtlety in the definition of the "
"{ref}`LLVM-IR Bitcast Instruction <i_bitcast>`. It is allowed to bitcast "
"between pointers with the same size, but different address spaces."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:185
msgid "G_ADDRSPACE_CAST"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:187
msgid ""
"Convert a pointer to an address space to a pointer to another address space."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:194
msgid ""
"{ref}`i_addrspacecast` doesn't mention what happens if the cast is simply "
"invalid (i.e. if the address spaces are disjoint)."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:198
msgid "Scalar Operations"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:200
msgid "G_EXTRACT"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:202
msgid ""
"Extract a register of the specified size, starting from the block given by "
"index. This will almost certainly be mapped to sub-register COPYs after "
"register banks have been selected."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:210
msgid "G_INSERT"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:212
msgid "Insert a smaller register into a larger one at the specified bit-index."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:218
msgid "G_MERGE_VALUES"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:220
msgid ""
"Concatenate multiple registers of the same size into a wider register. The "
"input operands are always ordered from lowest bits to highest:"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:228
msgid "G_UNMERGE_VALUES"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:230
msgid ""
"Extract multiple registers of the specified size, starting from blocks given "
"by indexes. This will almost certainly be mapped to sub-register COPYs after "
"register banks have been selected. The output operands are always ordered "
"from lowest bits to highest:"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:240
msgid "G_BSWAP"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:242
msgid "Reverse the order of the bytes in a scalar."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:248
msgid "G_BITREVERSE"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:250
msgid "Reverse the order of the bits in a scalar."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:256
msgid "G_SBFX, G_UBFX"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:258
msgid "Extract a range of bits from a register."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:260
msgid "The source operands are registers as follows:"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:262
msgid "Source"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:263
msgid "The least-significant bit for the extraction"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:264
msgid "The width of the extraction"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:266
msgid "The least-significant bit (lsb) and width operands are in the range:"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:272
msgid "G_SBFX sign-extends the result, while G_UBFX zero-extends the result."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:294
msgid "Integer Operations"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:296
msgid "G_ADD, G_SUB, G_MUL, G_AND, G_OR, G_XOR, G_SDIV, G_UDIV, G_SREM, G_UREM"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:298
msgid "These each perform their respective integer arithmetic on a scalar."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:304
msgid "The above example adds %src1 to %src0 and stores the result in %dst."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:306
msgid "G_CLMUL"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:308
msgid "Perform integer carry-less multiplication."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:314
msgid "G_CLMULH"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:316
msgid ""
"Perform carry-less multiplication and return the high half of the result. "
"For N-bit operands, compute the 2N-bit polynomial product over GF(2) and "
"return bits [2N-1:N]. The destination and both sources have the same type."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:324
msgid "G_SDIVREM, G_UDIVREM"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:326
msgid "Perform integer division and remainder thereby producing two results."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:332
msgid "G_SADDSAT, G_UADDSAT, G_SSUBSAT, G_USUBSAT, G_SSHLSAT, G_USHLSAT"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:334
msgid ""
"Signed and unsigned addition, subtraction and left shift with saturation."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:340
msgid "G_SHL, G_LSHR, G_ASHR"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:342
msgid ""
"Shift the bits of a scalar left or right inserting zeros (sign-bit for "
"G_ASHR)."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:344
msgid "G_ROTR, G_ROTL"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:346
msgid "Rotate the bits right (G_ROTR) or left (G_ROTL)."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:348
msgid "G_ICMP"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:350
msgid ""
"Perform integer comparison producing non-zero (true) or zero (false). It's "
"target specific whether a true value is 1, ~0U, or some other non-zero value."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:353
msgid "G_SCMP"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:355
msgid ""
"Perform signed 3-way integer comparison producing -1 (smaller), 0 (equal), "
"or 1 (larger)."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:361
msgid "G_UCMP"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:363
msgid ""
"Perform unsigned 3-way integer comparison producing -1 (smaller), 0 (equal), "
"or 1 (larger)."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:369
msgid "G_SELECT"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:371
msgid "Select between two values depending on a zero/non-zero value."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:377
msgid "G_PTR_ADD"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:379
msgid ""
"Add a scalar offset in addressible units to a pointer. Addressible units are "
"typically bytes but this may vary between targets."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:387
msgid ""
"There are currently no in-tree targets that use this with addressable units "
"not equal to 8 bit."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:391
msgid "G_PTRMASK"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:393
msgid ""
"Zero out an arbitrary mask of bits of a pointer. The mask type must be an "
"integer, and the number of vector elements must match for all operands. This "
"corresponds to `i_intr_llvm_ptrmask`."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:401
msgid "G_SMIN, G_SMAX, G_UMIN, G_UMAX"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:403
msgid "Take the minimum/maximum of two values."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:409
msgid "G_ABS"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:411
msgid ""
"Take the absolute value of a signed integer. The absolute value of the "
"minimum negative value (e.g. the 8-bit value `0x80`) is defined to be itself."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:418
msgid "G_UADDO, G_SADDO, G_USUBO, G_SSUBO, G_SMULO, G_UMULO"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:420
msgid ""
"Perform the requested arithmetic and produce a carry output in addition to "
"the normal result."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:427
msgid "G_UADDE, G_SADDE, G_USUBE, G_SSUBE"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:429
msgid ""
"Perform the requested arithmetic and consume a carry input in addition to "
"the normal input. Also produce a carry output in addition to the normal "
"result."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:436
msgid "G_UMULH, G_SMULH"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:438
msgid ""
"Multiply two numbers at twice the incoming bit width (unsigned or signed) "
"and return the high half of the result."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:445
msgid "G_CTLZ, G_CTTZ, G_CTPOP"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:447
msgid "Count leading zeros, trailing zeros, or number of set bits."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:455
msgid "G_CTLZ_ZERO_POISON, G_CTTZ_ZERO_POISON"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:457
msgid ""
"Count leading zeros or trailing zeros. If the value is zero then the result "
"is poison."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:465
msgid "G_CTLS"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:467
msgid ""
"Count leading redundant sign bits. If the value is positive then the result "
"is the number of extra leading zeros. If the value is negative then the "
"result is the number of extra leading ones."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:475
msgid "G_ABDS, G_ABDU"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:477
msgid ""
"Compute the absolute difference (signed and unsigned), e.g. trunc(abs(ext(x)-"
"ext(y))."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:484
msgid "G_UAVGFLOOR, G_UAVGCEIL, G_SAVGFLOOR, G_SAVGCEIL"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:486
msgid ""
"Computes the average of corresponding elements in two vectors (signed and "
"unsigned). Resulting vector contains values that are either rounded or "
"truncated. e.g. trunc(shr(add(ext(a),ext(b)),1))."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:496
msgid "Floating Point Operations"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:498
msgid "G_FCMP"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:500
msgid ""
"Perform floating point comparison producing non-zero (true) or zero (false). "
"It's target specific whether a true value is 1, ~0U, or some other non-zero "
"value."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:504
msgid "G_FNEG"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:506
msgid "Floating point negation."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:508
msgid "G_FPEXT"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:510
msgid "Convert a floating point value to a larger type."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:512
msgid "G_FPTRUNC"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:514
msgid "Convert a floating point value to a narrower type."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:516
msgid "G_FPTOSI, G_FPTOUI, G_SITOFP, G_UITOFP"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:518
msgid "Convert between integer and floating point."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:520
msgid "G_FPTOSI_SAT, G_FPTOUI_SAT"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:522
msgid "Saturating convert between integer and floating point."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:524
msgid "G_FABS"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:526
msgid "Take the absolute value of a floating point value."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:528
msgid "G_FCOPYSIGN"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:530
msgid ""
"Copy the value of the first operand, replacing the sign bit with that of the "
"second operand."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:533
msgid "G_FCANONICALIZE"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:535
msgid "See {ref}`i_intr_llvm_canonicalize`."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:537
msgid "G_IS_FPCLASS"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:539
msgid ""
"Tests if the first operand, which must be floating-point scalar or vector, "
"has floating-point class specified by the second operand. Returns non-zero "
"(true) or zero (false). It's target specific whether a true value is 1, ~0U, "
"or some other non-zero value. If the first operand is a vector, the returned "
"value is a vector of the same length."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:545
msgid "G_FMINNUM"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:547
msgid "Perform floating-point minimum on two values."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:549
#: ../../../GlobalISel/GenericOpcode.md:558
msgid ""
"In the case where a single input is a NaN (either signaling or quiet), the "
"non-NaN input is returned."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:552
msgid "The return value of (FMINNUM 0.0, -0.0) could be either 0.0 or -0.0."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:554
msgid "G_FMAXNUM"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:556
msgid "Perform floating-point maximum on two values."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:561
msgid "The return value of (FMAXNUM 0.0, -0.0) could be either 0.0 or -0.0."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:563
msgid "G_FMINNUM_IEEE"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:565
msgid ""
"Perform floating-point minimum on two values, following IEEE-754 "
"definitions. This differs from FMINNUM in the handling of signaling NaNs."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:569
#: ../../../GlobalISel/GenericOpcode.md:583
msgid ""
"If one input is a signaling NaN, returns a quiet NaN. This matches IEEE-754 "
"2008's minnum/maxnum for signaling NaNs (which differs from 2019)."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:573
#: ../../../GlobalISel/GenericOpcode.md:587
msgid ""
"These treat -0 as ordered less than +0, matching the behavior of IEEE-754 "
"2019's minimumNumber/maximumNumber (which was unspecified in 2008)."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:577
msgid "G_FMAXNUM_IEEE"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:579
msgid ""
"Perform floating-point maximum on two values, following IEEE-754 "
"definitions. This differs from FMAXNUM in the handling of signaling NaNs."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:591
msgid "G_FMINIMUM"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:593
msgid ""
"NaN-propagating minimum that also treat -0.0 as less than 0.0. While "
"FMINNUM_IEEE follow IEEE 754-2008 semantics, FMINIMUM follows IEEE 754-2019 "
"semantics."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:597
msgid "G_FMAXIMUM"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:599
msgid ""
"NaN-propagating maximum that also treat -0.0 as less than 0.0. While "
"FMAXNUM_IEEE follow IEEE 754-2008 semantics, FMAXIMUM follows IEEE 754-2019 "
"semantics."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:603
msgid "G_FMINIMUMNUM"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:605
msgid "IEEE-754 2019 minimumNumber"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:607
msgid "G_FMAXIMUMNUM"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:609
msgid "IEEE-754 2019 maximumNumber"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:611
msgid "G_FADD, G_FSUB, G_FMUL, G_FDIV, G_FREM"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:613
msgid "Perform the specified floating point arithmetic."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:615
msgid "G_FMA"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:617
msgid ""
"Perform a fused multiply add (i.e. without the intermediate rounding step)."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:619
msgid "G_FMAD"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:621
msgid ""
"Perform a non-fused multiply add (i.e. with the intermediate rounding step)."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:623
msgid "G_FPOW"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:625
msgid "Raise the first operand to the power of the second."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:627
msgid "G_FEXP, G_FEXP2"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:629
msgid "Calculate the base-e or base-2 exponential of a value"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:631
msgid "G_FLOG, G_FLOG2, G_FLOG10"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:633
msgid "Calculate the base-e, base-2, or base-10 respectively."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:635
msgid "G_FCEIL, G_FSQRT, G_FFLOOR, G_FRINT, G_FNEARBYINT"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:637
msgid "These correspond to the standard C functions of the same name."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:639
msgid ""
"G_FCOS, G_FSIN, G_FSINCOS, G_FTAN, G_FACOS, G_FASIN, G_FATAN, G_FATAN2, "
"G_FCOSH, G_FSINH, G_FTANH"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:641
msgid ""
"These correspond to the standard C trigonometry functions of the same name."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:643
msgid "G_INTRINSIC_TRUNC"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:645
msgid ""
"Returns the operand rounded to the nearest integer not larger in magnitude "
"than the operand."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:647
msgid "G_INTRINSIC_ROUND"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:649
msgid "Returns the operand rounded to the nearest integer."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:651
msgid "G_LROUND, G_LLROUND"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:653
msgid ""
"Returns the source operand rounded to the nearest integer with ties away "
"from zero."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:656
msgid ""
"See the LLVM LangRef entry on '`llvm.lround.*'` for details on behaviour."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:663
msgid "Vector Specific Operations"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:665
msgid "G_VSCALE"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:667
msgid ""
"Puts the value of the runtime `vscale` multiplied by the value in the source "
"operand into the destination register. This can be useful in determining the "
"actual runtime number of elements in a vector."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:675
msgid "G_INSERT_SUBVECTOR"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:677
msgid ""
"Insert the second source vector into the first source vector. The index "
"operand represents the starting index in the first source vector at which "
"the second source vector should be inserted into."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:681
msgid ""
"The index must be a constant multiple of the second source vector's minimum "
"vector length. If the vectors are scalable, then the index is first scaled "
"by the runtime scaling factor. The indices inserted in the source vector "
"must be valid indices of that vector. If this condition cannot be determined "
"statically but is false at runtime, then the result vector is undefined."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:687
msgid ""
"This operation supports inserting a fixed vector into a scalable vector, but "
"not the other way around."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:694
msgid "G_EXTRACT_SUBVECTOR"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:696
msgid ""
"Extract a vector of destination type from the source vector. The index "
"operand represents the starting index from which a subvector is extracted "
"from the source vector."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:700
msgid ""
"The index must be a constant multiple of the destination vector's minimum "
"vector length. If the source vector is a scalable vector, then the index is "
"first scaled by the runtime scaling factor. The indices extracted from the "
"source vector must be valid indices of that vector. If this condition cannot "
"be determined statically but is false at runtime, then the result vector is "
"undefined."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:707
msgid ""
"This operation supports extracting a fixed vector from a scalable vector, "
"but not the other way around."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:714
msgid "G_CONCAT_VECTORS"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:716
msgid "Concatenate vectors to form a longer vector."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:723
msgid "G_BUILD_VECTOR, G_BUILD_VECTOR_TRUNC"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:725
msgid ""
"Create a vector from multiple scalar registers. No implicit conversion is "
"performed (i.e. the result element type must be the same as all source "
"operands)"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:729
msgid ""
"The \\_TRUNC version truncates the larger operand types to fit the "
"destination vector elt type."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:738
msgid "G_INSERT_VECTOR_ELT"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:740
msgid "Insert an element into a vector"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:746
msgid "G_EXTRACT_VECTOR_ELT"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:748
msgid "Extract an element from a vector"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:754
msgid "G_SHUFFLE_VECTOR"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:756
msgid ""
"Concatenate two vectors and shuffle the elements according to the mask "
"operand. The mask operand should be an IR Constant which exactly matches the "
"corresponding mask for the IR shufflevector instruction."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:760
msgid "G_SPLAT_VECTOR"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:762
msgid ""
"Create a vector where all elements are the scalar from the source operand."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:764
msgid ""
"The type of the operand must be equal to or larger than the vector element "
"type. If the operand is larger than the vector element type, the scalar is "
"implicitly truncated to the vector element type."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:768
msgid "G_STEP_VECTOR"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:770
msgid ""
"Create a scalable vector where all lanes are linear sequences starting at 0 "
"with a given unsigned step."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:773
msgid ""
"The type of the operand must be equal to the vector element type. Arithmetic "
"is performed modulo the bitwidth of the element. The step must be > 0. "
"Otherwise the vector is zero."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:785
msgid "G_VECTOR_COMPRESS"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:787
msgid ""
"Given an input vector, a mask vector, and a passthru vector, continuously "
"place all selected (i.e., where mask[i] = true) input lanes in an output "
"vector. All remaining lanes in the output are taken from passthru, which may "
"be undef."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:791
msgid "Vector Reduction Operations"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:793
msgid ""
"These operations represent horizontal vector reduction, producing a scalar "
"result."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:795
msgid "G_VECREDUCE_SEQ_FADD, G_VECREDUCE_SEQ_FMUL"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:797
msgid ""
"The SEQ variants perform reductions in sequential order. The first operand "
"is an initial scalar accumulator value, and the second operand is the vector "
"to reduce."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:800
msgid "G_VECREDUCE_FADD, G_VECREDUCE_FMUL"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:802
msgid ""
"These reductions are relaxed variants which may reduce the elements in any "
"order."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:804
msgid ""
"G_VECREDUCE_FMAX, G_VECREDUCE_FMIN, G_VECREDUCE_FMAXIMUM, "
"G_VECREDUCE_FMINIMUM, G_VECREDUCE_FMAXIMUMNUM, G_VECREDUCE_FMINIMUMNUM"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:806
msgid ""
"FMIN/FMAX/FMINIMUM/FMAXIMUM/FMINIMUMNUM/FMAXIMUMNUM nodes can have flags, "
"for NaN/NoNaN variants."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:809
msgid "Integer/bitwise reductions"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:811
msgid "G_VECREDUCE_ADD"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:812
msgid "G_VECREDUCE_MUL"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:813
msgid "G_VECREDUCE_AND"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:814
msgid "G_VECREDUCE_OR"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:815
msgid "G_VECREDUCE_XOR"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:816
msgid "G_VECREDUCE_SMAX"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:817
msgid "G_VECREDUCE_SMIN"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:818
msgid "G_VECREDUCE_UMAX"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:819
msgid "G_VECREDUCE_UMIN"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:821
msgid ""
"Integer reductions may have a result type larger than the vector element "
"type. However, the reduction is performed using the vector element type and "
"the value in the top bits is unspecified."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:825
msgid "Memory Operations"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:827
msgid "G_LOAD, G_SEXTLOAD, G_ZEXTLOAD"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:829
msgid ""
"Generic load. Expects a MachineMemOperand in addition to explicit operands. "
"If the result size is larger than the memory size, the high bits are "
"undefined, sign-extended, or zero-extended respectively."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:833
msgid ""
"Only G_LOAD is valid if the result is a vector type. If the result is larger "
"than the memory size, the high elements are undefined (i.e. this is not a "
"per-element, vector anyextload)"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:837
msgid ""
"Unlike in SelectionDAG, atomic loads are expressed with the same opcodes as "
"regular loads. G_LOAD, G_SEXTLOAD and G_ZEXTLOAD may all have atomic memory "
"operands."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:841
msgid "G_FPEXTLOAD"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:843
msgid ""
"Generic floating-point extending load. Expects a MachineMemOperand in "
"addition to explicit operands. Loads a floating-point value from memory and "
"extends it to a larger floating-point type."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:847
msgid ""
"The memory size must be smaller than the result type. For example, loading "
"an f32 value from memory and extending it to f64, or loading an f16 value "
"and extending it to f32."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:855
msgid "G_INDEXED_LOAD"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:857
msgid ""
"Generic indexed load. Combines a GEP with a load. \\$newaddr is set to \\"
"$base + \\$offset. If \\$am is 0 (post-indexed), then the value is loaded "
"from \\$base; if \\$am is 1 (pre-indexed) then the value is loaded from \\"
"$newaddr."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:861
msgid "G_INDEXED_SEXTLOAD"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:863
msgid ""
"Same as G_INDEXED_LOAD except that the load performed is sign-extending, as "
"with G_SEXTLOAD."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:865
msgid "G_INDEXED_ZEXTLOAD"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:867
msgid ""
"Same as G_INDEXED_LOAD except that the load performed is zero-extending, as "
"with G_ZEXTLOAD."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:869
msgid "G_STORE"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:871
msgid ""
"Generic store. Expects a MachineMemOperand in addition to explicit operands. "
"If the stored value size is greater than the memory size, the high bits are "
"implicitly truncated. If this is a vector store, the high elements are "
"discarded (i.e. this does not function as a per-lane vector, truncating "
"store)"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:877
msgid "G_FPTRUNCSTORE"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:879
msgid ""
"Generic floating-point truncating store. Expects a MachineMemOperand in "
"addition to explicit operands. Truncates a floating-point value to a smaller "
"floating-point type and stores it to memory."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:883
msgid ""
"The memory size must be smaller than the source value type. For example, "
"truncating an f64 value to f32 and storing it, or truncating an f32 value to "
"f16 and storing it."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:891
msgid "G_INDEXED_STORE"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:893
msgid ""
"Combines a store with a GEP. See description of G_INDEXED_LOAD for indexing "
"behaviour."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:895
msgid "G_ATOMIC_CMPXCHG_WITH_SUCCESS"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:897
msgid ""
"Generic atomic cmpxchg with internal success check. Expects a "
"MachineMemOperand in addition to explicit operands."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:900
msgid "G_ATOMIC_CMPXCHG"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:902
msgid ""
"Generic atomic cmpxchg. Expects a MachineMemOperand in addition to explicit "
"operands."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:905
msgid ""
"<h3 id=\"all-g-atomicrmw\">G_ATOMICRMW_XCHG, G_ATOMICRMW_ADD,\n"
"G_ATOMICRMW_SUB, G_ATOMICRMW_AND, G_ATOMICRMW_NAND, G_ATOMICRMW_OR,\n"
"G_ATOMICRMW_XOR, G_ATOMICRMW_MAX, G_ATOMICRMW_MIN, G_ATOMICRMW_UMAX,\n"
"G_ATOMICRMW_UMIN, G_ATOMICRMW_FADD, G_ATOMICRMW_FSUB, G_ATOMICRMW_FMAX,\n"
"G_ATOMICRMW_FMIN, G_ATOMICRMW_FMAXIMUM, G_ATOMICRMW_FMINIMUM,\n"
"G_ATOMICRMW_UINC_WRAP, G_ATOMICRMW_UDEC_WRAP, G_ATOMICRMW_USUB_COND,\n"
"G_ATOMICRMW_USUB_SAT</h3>\n"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:913
msgid ""
"Generic atomicrmw. Expects a MachineMemOperand in addition to explicit "
"operands."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:916
msgid "G_FENCE"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:918
msgid ""
"Generic fence. The first operand is the memory ordering. The second operand "
"is the syncscope."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:921
msgid ""
"See the LLVM LangRef entry on the '`fence'` instruction for more details."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:923
msgid "G_MEMCPY"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:925
msgid ""
"Generic memcpy. Expects two MachineMemOperands covering the store and load "
"respectively, in addition to explicit operands."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:928
msgid "G_MEMCPY_INLINE"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:930
msgid ""
"Generic inlined memcpy. Like G_MEMCPY, but it is guaranteed that this "
"version will not be lowered as a call to an external function. Currently the "
"size operand is required to evaluate as a constant (not an immediate), "
"though that is expected to change when llvm.memcpy.inline is taught to "
"support dynamic sizes."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:935
msgid "G_MEMMOVE"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:937
msgid ""
"Generic memmove. Similar to G_MEMCPY, but the source and destination memory "
"ranges are allowed to overlap."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:940
msgid "G_MEMSET"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:942
msgid ""
"Generic memset. Expects a MachineMemOperand in addition to explicit operands."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:944
msgid "G_BZERO"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:946
msgid ""
"Generic bzero. Expects a MachineMemOperand in addition to explicit operands."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:948
msgid "Control Flow"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:950
msgid "G_PHI"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:952
msgid "Implement the φ node in the SSA graph representing the function."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:958
msgid "G_BR"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:960
msgid "Unconditional branch"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:966
msgid "G_BRCOND"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:968
msgid "Conditional branch"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:974
msgid "G_BRINDIRECT"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:976
msgid "Indirect branch"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:982
msgid "G_BRJT"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:984
msgid "Indirect branch to jump table entry"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:990
msgid "G_JUMP_TABLE"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:992
msgid ""
"Generates a pointer to the address of the jump table specified by the source "
"operand. The source operand is a jump table index. G_JUMP_TABLE can be used "
"in conjunction with G_BRJT to support jump table codegen with GlobalISel."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:1001
msgid "The above example generates a pointer to the source jump table index."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:1003
msgid "G_INVOKE_REGION_START"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:1005
msgid ""
"A marker instruction that acts as a pseudo-terminator for regions of code "
"that may throw exceptions. Being a terminator, it prevents code from being "
"inserted after it during passes like legalization. This is needed because "
"calls to exception throw routines do not return, so no code that must be on "
"an executable path must be placed after throwing."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:1011
msgid "G_INTRINSIC, G_INTRINSIC_CONVERGENT"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:1013
msgid "Call an intrinsic that has no side-effects."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:1015
#: ../../../GlobalISel/GenericOpcode.md:1027
msgid ""
"The \\_CONVERGENT variant corresponds to an LLVM IR intrinsic marked "
"`convergent`."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:1018
#: ../../../GlobalISel/GenericOpcode.md:1030
msgid ""
"Unlike SelectionDAG, there is no \\_VOID variant. Both of these are "
"permitted to have zero, one, or multiple results."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:1022
msgid "G_INTRINSIC_W_SIDE_EFFECTS, G_INTRINSIC_CONVERGENT_W_SIDE_EFFECTS"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:1024
msgid ""
"Call an intrinsic that is considered to have unknown side-effects and as "
"such cannot be reordered across other side-effecting instructions."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:1034
msgid "G_TRAP, G_DEBUGTRAP, G_UBSANTRAP"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:1036
msgid ""
"Represents {ref}`llvm.trap <llvm.trap>`, {ref}`llvm.debugtrap <llvm."
"debugtrap>` and {ref}`llvm.ubsantrap <llvm.ubsantrap>` that generate a "
"target-dependent trap instructions."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:1052
msgid "Variadic Arguments"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:1054
msgid "G_VASTART"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:1057
#: ../../../GlobalISel/GenericOpcode.md:1063
msgid "I found no documentation for this instruction at the time of writing."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:1060
msgid "G_VAARG"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:1066
msgid "Other Operations"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:1068
msgid "G_DYN_STACKALLOC"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:1070
msgid ""
"Dynamically realigns the stack pointer to the specified size and alignment. "
"An alignment value of `0` or `1` means no specific alignment."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:1077
msgid "G_FREEZE"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:1079
msgid "G_FREEZE is used to stop propagation of undef and poison values."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:1085
msgid "Optimization Hints"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:1087
msgid ""
"These instructions do not correspond to any target instructions. They act as "
"hints for various combines."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:1090
msgid "G_ASSERT_SEXT, G_ASSERT_ZEXT"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:1092
msgid ""
"This signifies that the contents of a register were previously extended from "
"a smaller type."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:1095
msgid ""
"The smaller type is denoted using an immediate operand. For scalars, this is "
"the width of the entire smaller type. For vectors, this is the width of the "
"smaller element type."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:1106
msgid ""
"G_ASSERT_SEXT and G_ASSERT_ZEXT act like copies, albeit with some "
"restrictions."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:1108
msgid "The source and destination registers must"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:1110
msgid "Be virtual"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:1111
msgid "Belong to the same register class"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:1112
msgid "Belong to the same register bank"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:1114
msgid "It should always be safe to"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:1116
msgid "Look through the source register"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:1117
msgid "Replace the destination register with the source register"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:1119
msgid "Miscellaneous"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:1121
msgid "G_CONSTANT_FOLD_BARRIER"
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:1123
msgid ""
"This operation is used as an opaque barrier to prevent constant folding. "
"Combines and other transformations should not look through this. These have "
"no other semantics and can be safely eliminated if a target chooses."
msgstr ""

#: ../../../GlobalISel/GenericOpcode.md:1127
msgid ""
"Unlisted: G_STACKSAVE, G_STACKRESTORE, G_FSHL, G_FSHR, G_SMULFIX, G_UMULFIX, "
"G_SMULFIXSAT, G_UMULFIXSAT, G_SDIVFIX, G_UDIVFIX, G_SDIVFIXSAT, "
"G_UDIVFIXSAT, G_FPOWI, G_FEXP10, G_FLDEXP, G_FFREXP, G_GET_FPENV, "
"G_SET_FPENV, G_RESET_FPENV, G_GET_FPMODE, G_SET_FPMODE, G_RESET_FPMODE, "
"G_INTRINSIC_FPTRUNC_ROUND, G_INTRINSIC_LRINT, G_INTRINSIC_LLRINT, "
"G_INTRINSIC_ROUNDEVEN, G_READCYCLECOUNTER, G_READSTEADYCOUNTER, G_PREFETCH, "
"G_READ_REGISTER, G_WRITE_REGISTER, G_STRICT_FADD, G_STRICT_FSUB, "
"G_STRICT_FMUL, G_STRICT_FDIV, G_STRICT_FREM, G_STRICT_FMA, G_STRICT_FSQRT, "
"G_STRICT_FLDEXP, G_ASSERT_ALIGN"
msgstr ""
