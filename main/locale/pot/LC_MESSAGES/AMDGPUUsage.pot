"32-bit pointer to GPU memory containing the global internal table (should "
"always point to *user data register* 0)."
msgstr ""

#: ../../../AMDGPUUsage.rst:20607
msgid "0x10000001"
msgstr ""

#: ../../../AMDGPUUsage.rst:20607
msgid "PerShaderTable"
msgstr ""

