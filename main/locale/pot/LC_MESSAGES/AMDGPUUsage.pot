#: ../../../AMDGPUUsage.rst:2914
msgid "<function_name>.num_vgpr"
msgstr ""

#: ../../../AMDGPUUsage.rst:2914 ../../../AMDGPUUsage.rst:2917
#: ../../../AMDGPUUsage.rst:2920 ../../../AMDGPUUsage.rst:2924
msgid "Integer"
msgstr ""

#: ../../../AMDGPUUsage.rst:2914
msgid ""
"Number of VGPRs used by <function_name>, worst case of itself and its "
"callees' VGPR use"
