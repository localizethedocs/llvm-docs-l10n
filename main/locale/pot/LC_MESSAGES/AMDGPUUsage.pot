msgid ""
"The AMDGPU backend generates ``Elf64_Rela`` relocation records for AMDHSA or "
"``Elf64_Rel`` relocation records for Mesa/AMDPAL. Supported relocatable "
"fields are:"
msgstr ""

#: ../../../AMDGPUUsage.rst:3869 ../../../AMDGPUUsage.rst:3919
#: ../../../AMDGPUUsage.rst:3921 ../../../AMDGPUUsage.rst:3925
#: ../../../AMDGPUUsage.rst:3927 ../../../AMDGPUUsage.rst:3929
