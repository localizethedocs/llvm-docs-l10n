msgstr ""

#: ../../../AMDGPUUsage.md:16931
msgid "`ELFOSABI_AMDGPU_HSA` (`0x40`)"
msgstr ""

#: ../../../AMDGPUUsage.md:16933
msgid "`ET_CORE` (`0x4`)"
msgstr ""

#: ../../../AMDGPUUsage.md:16935
msgid "`ELFABIVERSION_AMDGPU_HSA_5`"
