msgstr ""

#: ../../../YamlIO.md:223
msgid "`int8_t`"
msgstr ""

#: ../../../YamlIO.md:224
msgid "`uint64_t`"
msgstr ""

#: ../../../YamlIO.md:225
msgid "`uint32_t`"
msgstr ""

