#: ../../../AMDGPUInstructionNotation.rst:3
msgid "AMDGPU Instructions Notation"
msgstr ""

#: ../../../AMDGPUInstructionNotation.rst:9
msgid "Introduction"
msgstr ""

#: ../../../AMDGPUInstructionNotation.rst:11
msgid ""
"This is an overview of notation used to describe the syntax of AMDGPU "
"assembler instructions."
msgstr ""

#: ../../../AMDGPUInstructionNotation.rst:13
msgid ""
"This notation looks a lot like the :ref:`syntax of assembler "
"instructions<amdgpu_syn_instructions>`, except that instead of real operands "
"and modifiers, it uses references to their descriptions."
msgstr ""

#: ../../../AMDGPUInstructionNotation.rst:17
msgid "Instructions"
msgstr ""

#: ../../../AMDGPUInstructionNotation.rst:20
#: ../../../AMDGPUInstructionNotation.rst:34
#: ../../../AMDGPUInstructionNotation.rst:54
#: ../../../AMDGPUInstructionNotation.rst:132
msgid "Notation"
msgstr ""

#: ../../../AMDGPUInstructionNotation.rst:22
msgid "This is the notation used to describe AMDGPU instructions:"
msgstr ""

#: ../../../AMDGPUInstructionNotation.rst:0
msgid ""
"``<``\\ :ref:`opcode description<amdgpu_syn_opcode_notation>`\\ ``> <``\\ :"
"ref:`operands description<amdgpu_syn_instruction_operands_notation>`\\ ``> "
"<``\\ :ref:`modifiers "
"description<amdgpu_syn_instruction_modifiers_notation>`\\ ``>``"
msgstr ""

#: ../../../AMDGPUInstructionNotation.rst:31
msgid "Opcode"
msgstr ""

#: ../../../AMDGPUInstructionNotation.rst:36
msgid "TBD"
msgstr ""

#: ../../../AMDGPUInstructionNotation.rst:41
msgid "Operands"
msgstr ""

#: ../../../AMDGPUInstructionNotation.rst:43
msgid ""
"An instruction may have zero or more *operands*. They are comma-separated in "
"the description:"
msgstr ""

#: ../../../AMDGPUInstructionNotation.rst:0
msgid ""
"``<``\\ :ref:`description of operand "
"0<amdgpu_syn_instruction_operand_notation>`\\ ``>, <``\\ :ref:`description "
"of operand 1<amdgpu_syn_instruction_operand_notation>`\\ ``>, ...``"
msgstr ""

#: ../../../AMDGPUInstructionNotation.rst:48
msgid ""
"The order of *operands* is fixed. *Operands* cannot be omitted except for "
"special cases described below."
msgstr ""

#: ../../../AMDGPUInstructionNotation.rst:56
msgid "An operand is described using the following notation:"
msgstr ""

#: ../../../AMDGPUInstructionNotation.rst:58
msgid "*<kind><name><tag0><tag1>...*"
msgstr ""

#: ../../../AMDGPUInstructionNotation.rst:60
msgid "Where:"
msgstr ""

#: ../../../AMDGPUInstructionNotation.rst:62
msgid ""
"*kind* is an optional prefix describing operand :ref:"
"`kind<amdgpu_syn_instruction_operand_kinds>`."
msgstr ""

#: ../../../AMDGPUInstructionNotation.rst:63
msgid "*name* is a link to a description of the operand."
msgstr ""

#: ../../../AMDGPUInstructionNotation.rst:64
msgid ""
"*tags* are optional. They are used to indicate :ref:`special operand "
"properties<amdgpu_syn_instruction_operand_tags>`."
msgstr ""

#: ../../../AMDGPUInstructionNotation.rst:70
msgid "Operand Kinds"
msgstr ""

#: ../../../AMDGPUInstructionNotation.rst:72
msgid "Operand kind indicates which values are accepted by the operand."
msgstr ""

#: ../../../AMDGPUInstructionNotation.rst:74
msgid ""
"Operands which only accept *vector* registers are labelled with 'v' prefix."
msgstr ""

#: ../../../AMDGPUInstructionNotation.rst:75
msgid ""
"Operands which only accept *scalar* registers and values are labelled with "
"'s' prefix."
msgstr ""

#: ../../../AMDGPUInstructionNotation.rst:76
msgid "Operands which accept any registers and values have no prefix."
msgstr ""

#: ../../../AMDGPUInstructionNotation.rst:78
#: ../../../AMDGPUInstructionNotation.rst:109
msgid "Examples:"
msgstr ""

#: ../../../AMDGPUInstructionNotation.rst:89
msgid "Operand Tags"
msgstr ""

#: ../../../AMDGPUInstructionNotation.rst:91
msgid "Operand tags indicate special operand properties."
msgstr ""

#: ../../../AMDGPUInstructionNotation.rst:94
msgid "Operand tag"
msgstr ""

#: ../../../AMDGPUInstructionNotation.rst:94
msgid "Meaning"
msgstr ""

#: ../../../AMDGPUInstructionNotation.rst:96
msgid ":opt"
msgstr ""

#: ../../../AMDGPUInstructionNotation.rst:96
msgid "An optional operand."
msgstr ""

#: ../../../AMDGPUInstructionNotation.rst:97
msgid ":m"
msgstr ""

#: ../../../AMDGPUInstructionNotation.rst:97
msgid ""
"An operand which may be used with operand modifiers :ref:"
"`abs<amdgpu_synid_abs>`, :ref:`neg<amdgpu_synid_neg>` or :ref:"
"`sext<amdgpu_synid_sext>`."
msgstr ""

#: ../../../AMDGPUInstructionNotation.rst:100
msgid ":dst"
msgstr ""

#: ../../../AMDGPUInstructionNotation.rst:100
msgid ""
"An input operand which is also used as a destination if :ref:"
"`glc<amdgpu_synid_glc>` modifier is specified."
msgstr ""

#: ../../../AMDGPUInstructionNotation.rst:102
msgid ":fx"
msgstr ""

#: ../../../AMDGPUInstructionNotation.rst:102
msgid ""
"This is a *f32* or *f16* operand, depending on :ref:"
"`m_op_sel_hi<amdgpu_synid_mad_mix_op_sel_hi>` modifier."
msgstr ""

#: ../../../AMDGPUInstructionNotation.rst:104
msgid ":<type>"
msgstr ""

#: ../../../AMDGPUInstructionNotation.rst:104
msgid ""
"The operand *type* differs from the *type* :ref:`implied by the opcode "
"name<amdgpu_syn_instruction_type>`. This tag specifies the actual operand "
"*type*."
msgstr ""

#: ../../../AMDGPUInstructionNotation.rst:120
msgid "Modifiers"
msgstr ""

#: ../../../AMDGPUInstructionNotation.rst:122
msgid ""
"An instruction may have zero or more optional *modifiers*. They are space-"
"separated in the description:"
msgstr ""

#: ../../../AMDGPUInstructionNotation.rst:0
msgid ""
"``<``\\ :ref:`description of modifier "
"0<amdgpu_syn_instruction_modifier_notation>`\\ ``> <``\\ :ref:`description "
"of modifier 1<amdgpu_syn_instruction_modifier_notation>`\\ ``> ...``"
msgstr ""

#: ../../../AMDGPUInstructionNotation.rst:127
msgid "The order of *modifiers* is fixed."
msgstr ""

#: ../../../AMDGPUInstructionNotation.rst:134
msgid "A *modifier* is described using the following notation:"
msgstr ""

#: ../../../AMDGPUInstructionNotation.rst:136
msgid "*<name>*"
msgstr ""

#: ../../../AMDGPUInstructionNotation.rst:138
msgid "Where the *name* is a link to a description of the *modifier*."
msgstr ""
