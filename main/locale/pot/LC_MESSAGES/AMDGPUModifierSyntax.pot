#: ../../../AMDGPUModifierSyntax.md:973
msgid "wait_exp"
msgstr ""

#: ../../../AMDGPUModifierSyntax.md:975
msgid ""
"Specifies a wait on the EXP counter before issuing the current instruction. "
"The counter must be less than or equal to this value before the instruction "
"is issued. If set to 7, no wait is performed."
msgstr ""

#: ../../../AMDGPUModifierSyntax.md:979 ../../../AMDGPUModifierSyntax.md:1013
msgid ""
"The default value is zero. This is a safe value, but it may be suboptimal."
msgstr ""

#: ../../../AMDGPUModifierSyntax.md:425
msgid "wait_exp:{0..7}"
msgstr ""

#: ../../../AMDGPUModifierSyntax.md:425
msgid "An additional wait on the EXP counter before issuing this instruction."
msgstr ""

#: ../../../AMDGPUModifierSyntax.md:987
msgid "wait_va_vdst"
msgstr ""

#: ../../../AMDGPUModifierSyntax.md:989
msgid ""
"Manually specify a wait on the VA_VDST counter before issuing this "
"instruction. VA_VDST must be less than or equal to this value before the "
"instruction is issued. If set to 15, no wait is performed."
msgstr ""

#: ../../../AMDGPUModifierSyntax.md:992 ../../../AMDGPUModifierSyntax.md:1026
msgid ""
"If unspecified the current default is zero. This is a safe value but may "
"have poor performance characteristics."
msgstr ""

#: ../../../AMDGPUModifierSyntax.md:994
msgid ""
"This modifier is a shorthand for the WAR hazard where VALU reads a VGPR that "
"is written by a parameter load. Since there is no VA_VSRC counter we must "
"use VA_VDST as a proxy to detect when the VALU instruction has completed:"
msgstr ""

#: ../../../AMDGPUModifierSyntax.md:1007
msgid "wait_vdst"
msgstr ""

#: ../../../AMDGPUModifierSyntax.md:1009
msgid ""
"Specifies a wait on the VA_VDST counter before issuing the current "
"instruction. The counter must be less than or equal to this value before the "
"instruction is issued. If set to 15, no wait is performed."
msgstr ""

#: ../../../AMDGPUModifierSyntax.md:425
msgid "wait_vdst:{0..15}"
msgstr ""

#: ../../../AMDGPUModifierSyntax.md:425
msgid ""
"An additional wait on the VA_VDST counter before issuing this instruction."
msgstr ""

#: ../../../AMDGPUModifierSyntax.md:1021
msgid "wait_vm_vsrc"
msgstr ""

#: ../../../AMDGPUModifierSyntax.md:1023
msgid ""
"Manually specify a wait on the VM_VSRC counter before issuing this "
"instruction. VM_VSRC must be less than or equal to this value before the "
"instruction is issued. If set to 1, no wait is performed."
msgstr ""

#: ../../../AMDGPUModifierSyntax.md:1028
msgid ""
"This modifier is a shorthand for the WAR hazard where VMEM reads a VGPR that "
"is written by a parameter load."
msgstr ""

#: ../../../AMDGPUModifierSyntax.md:1038
msgid "DPP8 Modifiers"
msgstr ""

#: ../../../AMDGPUModifierSyntax.md:1042
msgid "dpp8_sel"
msgstr ""

#: ../../../AMDGPUModifierSyntax.md:1044
msgid ""
"Selects which lanes to pull data from, within a group of 8 lanes. This is a "
"mandatory modifier. There is no default value."
msgstr ""

#: ../../../AMDGPUModifierSyntax.md:1047
msgid ""
"The *dpp8_sel* modifier must specify exactly 8 values. The first value "
"selects which lane to read from to supply data into lane 0. The second value "
"controls lane 1 and so on."
msgstr ""

#: ../../../AMDGPUModifierSyntax.md:1051
msgid ""
"Each value may be specified as either an {ref}`integer "
"number<amdgpu_synid_integer_number>` or an {ref}`absolute "
"expression<amdgpu_synid_absolute_expression>`."
msgstr ""

#: ../../../AMDGPUModifierSyntax.md:425
msgid "dpp8:[{0..7},{0..7},{0..7},{0..7},{0..7},{0..7},{0..7},{0..7}]"
msgstr ""

#: ../../../AMDGPUModifierSyntax.md:425
msgid "Select lanes to read from."
msgstr ""

#: ../../../AMDGPUModifierSyntax.md:1068 ../../../AMDGPUModifierSyntax.md:1303
msgid "fi"
msgstr ""

#: ../../../AMDGPUModifierSyntax.md:1070
msgid ""
"Controls interaction with inactive lanes for *dpp8* instructions. The "
"default value is zero."
msgstr ""

#: ../../../AMDGPUModifierSyntax.md:1072 ../../../AMDGPUModifierSyntax.md:1307
msgid ""
"Note: *inactive* lanes are those whose {ref}`exec<amdgpu_synid_exec>` mask "
"bit is zero."
msgstr ""

#: ../../../AMDGPUModifierSyntax.md:425 ../../../AMDGPUModifierSyntax.md:1297
msgid "fi:0"
msgstr ""

#: ../../../AMDGPUModifierSyntax.md:425
msgid "Fetch zero when accessing data from inactive lanes."
msgstr ""

#: ../../../AMDGPUModifierSyntax.md:425 ../../../AMDGPUModifierSyntax.md:1297
msgid "fi:1"
msgstr ""

#: ../../../AMDGPUModifierSyntax.md:425 ../../../AMDGPUModifierSyntax.md:1297
msgid "Fetch pre-existing values from inactive lanes."
msgstr ""

#: ../../../AMDGPUModifierSyntax.md:1083
msgid "DPP Modifiers"
msgstr ""

#: ../../../AMDGPUModifierSyntax.md:1087
msgid "dpp_ctrl"
msgstr ""

#: ../../../AMDGPUModifierSyntax.md:1089 ../../../AMDGPUModifierSyntax.md:1124
#: ../../../AMDGPUModifierSyntax.md:1156 ../../../AMDGPUModifierSyntax.md:1192
msgid ""
"Specifies how data is shared between threads. This is a mandatory modifier. "
"There is no default value."
msgstr ""

#: ../../../AMDGPUModifierSyntax.md:1092 ../../../AMDGPUModifierSyntax.md:1159
#: ../../../AMDGPUModifierSyntax.md:1195
msgid ""
"Note: the lanes of a wavefront are organized in four *rows* and four *banks*."
msgstr ""

#: ../../../AMDGPUModifierSyntax.md:425
msgid "quad_perm:[{0..3},{0..3},{0..3},{0..3}]"
msgstr ""

#: ../../../AMDGPUModifierSyntax.md:425
msgid "Full permute of 4 threads."
msgstr ""

#: ../../../AMDGPUModifierSyntax.md:425
msgid "row_mirror"
msgstr ""

#: ../../../AMDGPUModifierSyntax.md:425
msgid "Mirror threads within row."
msgstr ""

#: ../../../AMDGPUModifierSyntax.md:425
msgid "row_half_mirror"
msgstr ""

#: ../../../AMDGPUModifierSyntax.md:425
msgid "Mirror threads within 1/2 row (8 threads)."
msgstr ""

#: ../../../AMDGPUModifierSyntax.md:425
msgid "row_bcast:15"
msgstr ""

#: ../../../AMDGPUModifierSyntax.md:425
msgid "Broadcast the 15th thread of each row to the next row."
msgstr ""

#: ../../../AMDGPUModifierSyntax.md:425
msgid "row_bcast:31"
msgstr ""

#: ../../../AMDGPUModifierSyntax.md:425
msgid "Broadcast thread 31 to rows 2 and 3."
msgstr ""

#: ../../../AMDGPUModifierSyntax.md:425
msgid "wave_shl:1"
msgstr ""

#: ../../../AMDGPUModifierSyntax.md:425
msgid "Wavefront left shift by 1 thread."
msgstr ""

#: ../../../AMDGPUModifierSyntax.md:425
msgid "wave_rol:1"
msgstr ""

#: ../../../AMDGPUModifierSyntax.md:425
msgid "Wavefront left rotate by 1 thread."
msgstr ""

#: ../../../AMDGPUModifierSyntax.md:425
msgid "wave_shr:1"
msgstr ""

#: ../../../AMDGPUModifierSyntax.md:425
msgid "Wavefront right shift by 1 thread."
msgstr ""

#: ../../../AMDGPUModifierSyntax.md:425
msgid "wave_ror:1"
msgstr ""

#: ../../../AMDGPUModifierSyntax.md:425
msgid "Wavefront right rotate by 1 thread."
msgstr ""

#: ../../../AMDGPUModifierSyntax.md:425
msgid "row_shl:{1..15}"
msgstr ""

#: ../../../AMDGPUModifierSyntax.md:425
msgid "Row shift left by 1-15 threads."
msgstr ""

#: ../../../AMDGPUModifierSyntax.md:425
msgid "row_shr:{1..15}"
msgstr ""

#: ../../../AMDGPUModifierSyntax.md:425
msgid "Row shift right by 1-15 threads."
msgstr ""

#: ../../../AMDGPUModifierSyntax.md:425
msgid "row_ror:{1..15}"
msgstr ""

#: ../../../AMDGPUModifierSyntax.md:425
msgid "Row rotate right by 1-15 threads."
msgstr ""

#: ../../../AMDGPUModifierSyntax.md:1122
msgid "dpp16_ctrl"
msgstr ""

#: ../../../AMDGPUModifierSyntax.md:1127 ../../../AMDGPUModifierSyntax.md:1217
#: ../../../AMDGPUModifierSyntax.md:1250
msgid ""
"Note: the lanes of a wavefront are organized in four *rows* and four "
"*banks*. (There are only two rows in *wave32* mode.)"
msgstr ""

#: ../../../AMDGPUModifierSyntax.md:425
msgid "row_share:{0..15}"
msgstr ""

#: ../../../AMDGPUModifierSyntax.md:425
msgid "Share the value from the specified lane with other lanes in the row."
msgstr ""

#: ../../../AMDGPUModifierSyntax.md:425
msgid "row_xmask:{0..15}"
msgstr ""

#: ../../../AMDGPUModifierSyntax.md:425
msgid "Fetch from XOR(\\<current lane id>,\\<specified lane id>)."
msgstr ""

#: ../../../AMDGPUModifierSyntax.md:1154
msgid "dpp32_ctrl"
msgstr ""

#: ../../../AMDGPUModifierSyntax.md:425
msgid "row_newbcast:{1..15}"
msgstr ""

#: ../../../AMDGPUModifierSyntax.md:425
msgid "Broadcast a thread within a row to the whole row."
msgstr ""

#: ../../../AMDGPUModifierSyntax.md:1190
msgid "dpp64_ctrl"
msgstr ""

#: ../../../AMDGPUModifierSyntax.md:1213
msgid "row_mask"
msgstr ""

#: ../../../AMDGPUModifierSyntax.md:1215
msgid ""
"Controls which rows are enabled for data sharing. By default, all rows are "
"enabled."
msgstr ""

#: ../../../AMDGPUModifierSyntax.md:1225
msgid "row_mask:{0..15}"
msgstr ""

#: ../../../AMDGPUModifierSyntax.md:1226
msgid ""
"Specifies a *row mask* as a positive {ref}`integer number "
"<amdgpu_synid_integer_number>` or an {ref}`absolute "
"expression<amdgpu_synid_absolute_expression>`."
msgstr ""

#: ../../../AMDGPUModifierSyntax.md:1230
msgid ""
"Each of the 4 bits in the mask controls one row (0 - disabled, 1 - enabled)."
msgstr ""

#: ../../../AMDGPUModifierSyntax.md:1233
msgid "In *wave32* mode, the values shall be limited to {0..7}."
msgstr ""

#: ../../../AMDGPUModifierSyntax.md:1246
msgid "bank_mask"
msgstr ""

#: ../../../AMDGPUModifierSyntax.md:1248
msgid ""
"Controls which banks are enabled for data sharing. By default, all banks are "
"enabled."
msgstr ""

#: ../../../AMDGPUModifierSyntax.md:1258
msgid "bank_mask:{0..15}"
msgstr ""

#: ../../../AMDGPUModifierSyntax.md:1259
msgid ""
"Specifies a *bank mask* as a positive {ref}`integer number "
"<amdgpu_synid_integer_number>` or an {ref}`absolute "
"expression<amdgpu_synid_absolute_expression>`."
msgstr ""

#: ../../../AMDGPUModifierSyntax.md:1263
msgid ""
"Each of the 4 bits in the mask controls one bank (0 - disabled, 1 - enabled)."
msgstr ""

#: ../../../AMDGPUModifierSyntax.md:1277
msgid "bound_ctrl"
msgstr ""

#: ../../../AMDGPUModifierSyntax.md:1279
msgid ""
"Controls data sharing when accessing an invalid lane. By default, data "
"sharing with invalid lanes is disabled."
msgstr ""

#: ../../../AMDGPUModifierSyntax.md:1287
msgid "bound_ctrl:1"
msgstr ""

#: ../../../AMDGPUModifierSyntax.md:1288
msgid "Enables data sharing with invalid lanes."
msgstr ""

#: ../../../AMDGPUModifierSyntax.md:1290
msgid "Accessing data from an invalid lane will return zero."
msgstr ""

#: ../../../AMDGPUModifierSyntax.md:1293
msgid "bound_ctrl:0 (GFX11+)"
msgstr ""

#: ../../../AMDGPUModifierSyntax.md:1294
msgid "Disables data sharing with invalid lanes."
msgstr ""

#: ../../../AMDGPUModifierSyntax.md:1298
msgid ""
"For historical reasons, *bound_ctrl:0* has the same meaning as "
"*bound_ctrl:1* for older architectures."
msgstr ""

#: ../../../AMDGPUModifierSyntax.md:1305
msgid ""
"Controls interaction with *inactive* lanes for *dpp16* instructions. The "
"default value is zero."
msgstr ""

#: ../../../AMDGPUModifierSyntax.md:1297
msgid ""
"Interaction with inactive lanes is controlled by {ref}"
"`bound_ctrl<amdgpu_synid_bound_ctrl>`."
msgstr ""

