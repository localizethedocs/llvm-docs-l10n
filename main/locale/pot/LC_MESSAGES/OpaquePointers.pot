msgid "The `-no-opaque-pointers` cc1 clang flag is no longer supported."
msgstr ""

#: ../../../OpaquePointers.md:277
msgid "The `-opaque-pointers` opt flag is no longer supported."
msgstr ""

#: ../../../OpaquePointers.md:278
msgid "The `-plugin-opt=no-opaque-pointers` LTO flag is no longer supported."
msgstr ""

#: ../../../OpaquePointers.md:279
msgid ""
"C APIs that do not support opaque pointers (like `LLVMBuildLoad`) are no "
"longer supported."
msgstr ""

