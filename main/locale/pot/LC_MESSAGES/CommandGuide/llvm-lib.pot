#: ../../../CommandGuide/llvm-lib.md:1
msgid "llvm-lib - LLVM lib.exe compatible library tool"
msgstr ""

#: ../../../CommandGuide/llvm-lib.md:6
msgid "SYNOPSIS"
msgstr ""

#: ../../../CommandGuide/llvm-lib.md:8
msgid ""
"**llvm-lib** [/libpath:\\<path>] [/out:\\<output>] [/llvmlibthin] [/ignore] "
"[/machine] [/nologo] [files...]"
msgstr ""

#: ../../../CommandGuide/llvm-lib.md:11
msgid "DESCRIPTION"
msgstr ""

#: ../../../CommandGuide/llvm-lib.md:13
msgid ""
"The **llvm-lib** command is intended to be a `lib.exe` compatible tool. See "
"<https://msdn.microsoft.com/en-us/library/7ykb2k5f> for the general "
"description."
msgstr ""

#: ../../../CommandGuide/llvm-lib.md:17
msgid "**llvm-lib** has the following extensions:"
msgstr ""

#: ../../../CommandGuide/llvm-lib.md:19
msgid ""
"Bitcode files in symbol tables. **llvm-lib** includes symbols from both "
"bitcode files and regular object files in the symbol table."
msgstr ""

#: ../../../CommandGuide/llvm-lib.md:22
msgid ""
"Creating thin archives. The /llvmlibthin option causes **llvm-lib** to "
"create thin archive that contain only the symbol table and the header for "
"the various members. These files are much smaller, but are not compatible "
"with link.exe (lld can handle them)."
msgstr ""
