#: ../../../CommandGuide/llvm-remarkutil.md:1
msgid "llvm-remarkutil - Remark utility"
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:6
msgid "Synopsis"
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:8
msgid "{program}`llvm-remarkutil` \\[*subcommmand*\\] \\[*options*\\]"
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:10
msgid "Description"
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:12
msgid ""
"Utility for displaying information from, and converting between different "
"[remark](https://llvm.org/docs/Remarks.html) formats."
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:15
msgid "Subcommands"
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:17
msgid ""
"{ref}`bitstream2yaml-subcommand` - Reserialize bitstream remarks to YAML."
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:18
msgid ""
"{ref}`yaml2bitstream-subcommand` - Reserialize YAML remarks to bitstream."
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:19
msgid ""
"{ref}`instruction-count-subcommand` - Output function instruction counts."
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:20
msgid ""
"{ref}`annotation-count-subcommand` - Output remark type count from "
"annotation remarks."
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:21
msgid "{ref}`size-diff-subcommand` - Compute diff in size remarks."
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:25
msgid "bitstream2yaml"
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:30
msgid ""
"USAGE: {program}`llvm-remarkutil` bitstream2yaml \\<input file> -o \\<output "
"file>"
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:32
#: ../../../CommandGuide/llvm-remarkutil.md:45
#: ../../../CommandGuide/llvm-remarkutil.md:59
#: ../../../CommandGuide/llvm-remarkutil.md:89
#: ../../../CommandGuide/llvm-remarkutil.md:119
#: ../../../CommandGuide/llvm-remarkutil.md:207
msgid "Summary"
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:34
msgid ""
"Takes a bitstream remark file as input, and reserializes that file as YAML."
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:38
msgid "yaml2bitstream"
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:43
msgid ""
"USAGE: {program}`llvm-remarkutil` yaml2bitstream \\<input file> -o \\<output "
"file>"
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:47
msgid ""
"Takes a YAML remark file as input, and reserializes that file in the "
"bitstream format."
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:52
msgid "instruction-count"
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:57
msgid ""
"USAGE: {program}`llvm-remarkutil` instruction-count \\<input file> --"
"parser=\\<bitstream|yaml> [--use-debug-loc] -o \\<output file>"
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:61
msgid ""
"Outputs instruction count remarks for every function. Instruction count "
"remarks encode the number of instructions in a function at assembly printing "
"time."
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:64
msgid "Instruction count remarks require asm-printer remarks."
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:66
#: ../../../CommandGuide/llvm-remarkutil.md:96
msgid "CSV format is as follows:"
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:73
#: ../../../CommandGuide/llvm-remarkutil.md:103
msgid ""
"if `--use-debug-loc` is passed then the CSV will include the source path, "
"line number and column."
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:82
msgid "annotation-count"
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:87
msgid ""
"USAGE: {program}`llvm-remarkutil` annotation-count \\<input file> --"
"parser=\\<bitstream|yaml> --annotation-type=\\<type> [--use-debug-loc] -o "
"\\<output file>"
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:91
msgid ""
"Outputs a count for annotation-type `<type>` remark for every function. The "
"count expresses the number of remark checks inserted at the function."
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:94
msgid "Annotation count remarks require AnnotationRemarksPass remarks."
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:112
msgid "count"
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:117
msgid "USAGE: {program}`llvm-remarkutil` count \\[*options*\\] \\<input file>"
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:121
msgid ""
"{program}`llvm-remarkutil count` counts [remarks](https://llvm.org/docs/"
"Remarks.html) based on specified properties. By default the tool counts "
"remarks based on how many occur in a source file or function or total for "
"the generated remark file. The tool also supports collecting count based on "
"specific remark arguments. The specified arguments should have an integer "
"value to be able to report a count."
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:125
msgid ""
"The tool contains utilities to filter the remark count based on remark name, "
"pass name, argument value and remark type."
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:127
#: ../../../CommandGuide/llvm-remarkutil.md:224
msgid "Options"
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:130
#: ../../../CommandGuide/llvm-remarkutil.md:229
msgid "Select the type of input remark parser. Required."
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:132
#: ../../../CommandGuide/llvm-remarkutil.md:231
msgid "`yaml` : The tool will parse YAML remarks."
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:133
#: ../../../CommandGuide/llvm-remarkutil.md:232
msgid "`bitstream` : The tool will parse bitstream remarks."
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:137
msgid "Select option to collect remarks by."
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:139
msgid "`remark-name` : count how many individual remarks exist."
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:140
msgid ""
"`arg` : count remarks based on specified arguments passed by --(r)args. The "
"argument value must be a number."
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:144
msgid "group count of remarks by property."
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:146
msgid ""
"`source` : Count will be collected per source path. Remarks with no debug "
"location will not be counted."
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:147
msgid "`function` : Count is collected per function."
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:148
msgid ""
"`function-with-loc` : Count is collected per function per source. Remarks "
"with no debug location will not be counted."
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:149
msgid "`Total` : Report a count for the provided remark file."
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:153
msgid ""
"If `count-by` is set to `arg` this flag can be used to collect from "
"specified remark arguments represented as a comma separated string. The "
"arguments must have a numeral value to be able to count remarks by"
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:158
msgid ""
"If `count-by` is set to `arg` this flag can be used to collect from "
"specified remark arguments using regular expression. The arguments must have "
"a numeral value to be able to count remarks by"
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:163
msgid "Filter count by pass name."
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:167
msgid "Filter count by pass name using regular expressions."
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:171
msgid "Filter count by remark name."
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:175
msgid "Filter count by remark name using regular expressions."
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:179
msgid "Filter count by argument value."
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:183
msgid "Filter count by argument value using regular expressions."
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:187
msgid "Filter remarks by type with the following options."
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:189
msgid "`unknown`"
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:190
msgid "`passed`"
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:191
msgid "`missed`"
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:192
msgid "`analysis`"
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:193
msgid "`analysis-fp-commute`"
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:194
msgid "`analysis-aliasing`"
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:195
msgid "`failure`"
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:200
msgid "size-diff"
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:205
msgid ""
"USAGE: {program}`llvm-remarkutil` size-diff \\[*options*\\] *file_a* "
"*file_b* **--parser** *parser*"
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:209
msgid ""
"{program}`llvm-remarkutil size-diff` diffs size [remarks](https://llvm.org/"
"docs/Remarks.html) in two remark files: `file_a` and `file_b`."
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:212
msgid ""
"{program}`llvm-remarkutil size-diff` can be used to gain insight into which "
"functions were impacted the most by code generation changes."
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:215
msgid ""
"In most common use-cases `file_a` and `file_b` will be remarks output by "
"compiling a **fixed source** with **differing compilers** or **differing "
"optimization settings**."
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:219
msgid ""
"{program}`llvm-remarkutil size-diff` handles both [YAML](https://llvm.org/"
"docs/Remarks.html#yaml-remarks) and [bitstream](https://llvm.org/docs/"
"Remarks.html#llvm-bitstream-remarks) remarks."
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:235
msgid "Output style."
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:237
msgid "`human` : Human-readable textual report. Default option."
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:238
msgid "`json` : JSON report."
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:242
msgid "Pretty-print JSON output. Optional."
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:244
msgid "If output is not set to JSON, this does nothing."
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:248
msgid "Output file for the report. Outputs to stdout by default."
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:251
msgid "Human-Readable Output"
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:253
msgid ""
"The human-readable format for {program}`llvm-remarkutil size-diff` is "
"composed of two sections:"
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:256
msgid "Per-function changes."
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:257
msgid "A high-level summary of all changes."
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:259
msgid "Changed Function Section"
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:261
msgid "Suppose you are comparing two remark files OLD and NEW."
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:263
msgid ""
"For each function with a **changed instruction count** in OLD and NEW, "
"{program}`llvm-remarkutil size-diff` will emit a line like below:"
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:270
msgid "A breakdown of the format is below:"
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:272
msgid "`(++|--|==)`"
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:274
msgid "Which of OLD and NEW the `function_name` is present in."
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:276
msgid "`++`: Only in NEW. (\"Added\")"
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:277
msgid "`--`: Only in OLD. (\"Removed\")"
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:278
msgid "`==`: In both."
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:280
msgid "`(>|<)`"
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:282
msgid ""
"Denotes if `function_name` has more instructions or fewer instructions in "
"the second file."
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:285
msgid "`>`: More instructions in second file than first file."
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:286
msgid "`<`: Fewer instructions in second file than in first file."
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:288
msgid "`function_name`"
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:290
msgid "The name of the changed function."
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:292
msgid "`N instrs`"
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:294
msgid "Second file instruction count - first file instruction count."
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:296
msgid "`M stack B`"
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:298
msgid "Second file stack byte count - first file stack byte count."
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:300
msgid "Summary Section"
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:302
msgid ""
"{program}`llvm-remarkutil size-diff` will output a high-level summary after "
"printing all changed functions."
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:310
msgid "`N`"
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:312
msgid "Sum of all instruction count changes between the second and first file."
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:314
msgid "`inst_pct_change%`"
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:316
msgid ""
"Percent increase or decrease in instruction count between the second and "
"first file."
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:319
msgid "`M`"
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:321
msgid "Sum of all stack byte count changes between the second and first file."
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:323
msgid "`sb_pct_change%`"
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:325
msgid ""
"Percent increase or decrease in stack byte usage between the second and "
"first file."
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:328
msgid "JSON OUTPUT"
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:330
msgid "High-Level view"
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:332
msgid "Suppose we are comparing two files, OLD and NEW."
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:334
msgid "{program}`llvm-remarkutil size-diff` will output JSON as follows."
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:355
msgid "`Files`"
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:357
msgid "Original paths to remark files."
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:359
msgid "`A`: Path to the first file."
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:360
msgid "`B`: Path to the second file."
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:362
msgid "`InBoth`"
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:364
msgid "Functions present in both files."
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:366
msgid "`OnlyInA`"
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:368
msgid "Functions only present in the first file."
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:370
msgid "`OnlyInB`"
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:372
msgid "Functions only present in the second file."
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:374
msgid "Function JSON"
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:376
msgid ""
"The `InBoth`, `OnlyInA`, and `OnlyInB` sections contain size information for "
"each function in the input remark files."
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:393
msgid "`FunctionName`"
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:395
msgid "Name of the function."
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:397
msgid "`InstCount`"
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:399
msgid "Instruction counts for the function."
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:401
msgid "`INST_COUNT_A`: Instruction count in OLD."
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:402
msgid "`INST_COUNT_B`: Instruction count in NEW."
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:404
msgid "`StackSize`"
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:406
msgid "Stack byte counts for the function."
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:408
msgid "`STACK_BYTES_A`: Stack bytes in OLD."
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:409
msgid "`STACK_BYTES_B`: Stack bytes in NEW."
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:411
msgid "Computing Diffs From Function JSON"
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:413
msgid ""
"Function JSON does not contain the diffs. Tools consuming JSON output from "
"{program}`llvm-remarkutil size-diff` are responsible for computing the diffs "
"separately."
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:417
msgid "**To compute the diffs:**"
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:419
msgid "Instruction count diff: `INST_COUNT_B - INST_COUNT_A`"
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:420
msgid "Stack byte count diff: `STACK_BYTES_B - STACK_BYTES_A`"
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:422
msgid "EXIT STATUS"
msgstr ""

#: ../../../CommandGuide/llvm-remarkutil.md:424
msgid ""
"{program}`llvm-remarkutil size-diff` returns 0 on success, and a non-zero "
"value otherwise."
msgstr ""
