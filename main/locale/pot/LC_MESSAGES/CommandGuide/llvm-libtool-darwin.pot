#: ../../../CommandGuide/llvm-libtool-darwin.md:1
msgid "llvm-libtool-darwin - LLVM tool for creating libraries for Darwin"
msgstr ""

#: ../../../CommandGuide/llvm-libtool-darwin.md:6
msgid "SYNOPSIS"
msgstr ""

#: ../../../CommandGuide/llvm-libtool-darwin.md:8
msgid "{program}`llvm-libtool-darwin` \\[*options*\\] *\\<input files>*"
msgstr ""

#: ../../../CommandGuide/llvm-libtool-darwin.md:10
msgid "DESCRIPTION"
msgstr ""

#: ../../../CommandGuide/llvm-libtool-darwin.md:12
msgid ""
"{program}`llvm-libtool-darwin` is a tool for creating static and dynamic "
"libraries for Darwin."
msgstr ""

#: ../../../CommandGuide/llvm-libtool-darwin.md:15
msgid ""
"For most scenarios, it works as a drop-in replacement for cctools' {program}"
"`libtool`."
msgstr ""

#: ../../../CommandGuide/llvm-libtool-darwin.md:18
msgid "OPTIONS"
msgstr ""

#: ../../../CommandGuide/llvm-libtool-darwin.md:20
msgid "{program}`llvm-libtool-darwin` supports the following options:"
msgstr ""

#: ../../../CommandGuide/llvm-libtool-darwin.md:23
msgid ""
"Build a static library only for the specified `<architecture>` and ignore "
"all other architectures in the files."
msgstr ""

#: ../../../CommandGuide/llvm-libtool-darwin.md:28
msgid "Use zero for timestamps and UIDs/GIDs. This is set by default."
msgstr ""

#: ../../../CommandGuide/llvm-libtool-darwin.md:32
msgid ""
"Read input file names from `<listfile>`. File names are specified in "
"`<listfile>` one per line, separated only by newlines. Whitespace on a line "
"is assumed to be part of the filename. If the directory name, `dirname`, is "
"also specified then it is prepended to each file name in the `<listfile>`."
msgstr ""

#: ../../../CommandGuide/llvm-libtool-darwin.md:39
msgid "Show help and usage for this command."
msgstr ""

#: ../../../CommandGuide/llvm-libtool-darwin.md:43
msgid ""
"Searches for the library libx.a in the library search path. If the string "
"`<x>` ends with '.o', then the library 'x' is searched for without "
"prepending 'lib' or appending '.a'. If the library is found, it is added to "
"the list of input files. Otherwise, an error is raised."
msgstr ""

#: ../../../CommandGuide/llvm-libtool-darwin.md:50
msgid ""
"Adds `<dir>` to the list of directories in which to search for libraries. "
"The directories are searched in the order in which they are specified with "
"{option}`-L` and before the default search path. The default search path "
"includes directories `/lib`, `/usr/lib` and `/usr/local/lib`."
msgstr ""

#: ../../../CommandGuide/llvm-libtool-darwin.md:57
msgid "Do not warn about files that have no symbols."
msgstr ""

#: ../../../CommandGuide/llvm-libtool-darwin.md:61
msgid "Produce a non-zero exit status if any warnings are emitted."
msgstr ""

#: ../../../CommandGuide/llvm-libtool-darwin.md:65
msgid "Specify the output file name. Must be specified exactly once."
msgstr ""

#: ../../../CommandGuide/llvm-libtool-darwin.md:69
msgid "Produces a static library from the input files."
msgstr ""

#: ../../../CommandGuide/llvm-libtool-darwin.md:73
msgid "Use actual timestamps and UIDs/GIDs."
msgstr ""

#: ../../../CommandGuide/llvm-libtool-darwin.md:77
msgid ""
"Display the version of this program and perform any operation specified."
msgstr ""

#: ../../../CommandGuide/llvm-libtool-darwin.md:81
msgid "Display the version of this program and exit immediately."
msgstr ""

#: ../../../CommandGuide/llvm-libtool-darwin.md:84
msgid "EXIT STATUS"
msgstr ""

#: ../../../CommandGuide/llvm-libtool-darwin.md:86
msgid ""
"{program}`llvm-libtool-darwin` exits with a non-zero exit code if there is "
"an error. Otherwise, it exits with code 0."
msgstr ""

#: ../../../CommandGuide/llvm-libtool-darwin.md:89
msgid "BUGS"
msgstr ""

#: ../../../CommandGuide/llvm-libtool-darwin.md:91
msgid ""
