#: ../../../CommandGuide/llvm-profgen.rst:2
msgid "llvm-profgen - LLVM SPGO profile generation tool"
msgstr ""

#: ../../../CommandGuide/llvm-profgen.rst:7
msgid "SYNOPSIS"
msgstr ""

#: ../../../CommandGuide/llvm-profgen.rst:9
msgid ":program:`llvm-profgen` [*commands*] [*options*]"
msgstr ""

#: ../../../CommandGuide/llvm-profgen.rst:12
msgid "DESCRIPTION"
msgstr ""

#: ../../../CommandGuide/llvm-profgen.rst:14
msgid ""
"The :program:`llvm-profgen` utility generates a profile data file from given "
"perf script data files for sample-based profile guided optimization(SPGO)."
msgstr ""

#: ../../../CommandGuide/llvm-profgen.rst:19
msgid "COMMANDS"
msgstr ""

#: ../../../CommandGuide/llvm-profgen.rst:20
msgid "At least one of the following commands are required:"
msgstr ""

#: ../../../CommandGuide/llvm-profgen.rst:24
msgid ""
"Path of perf-script trace created by Linux perf tool with `script` "
"command(the raw perf.data should be profiled with -b)."
msgstr ""

#: ../../../CommandGuide/llvm-profgen.rst:29
msgid ""
"Path of the ETM trace file created by ARM CoreSight trace tools. Requires "
"the OpenCSD library version 1.5.4 or higher to be enabled during the build."
msgstr ""

#: ../../../CommandGuide/llvm-profgen.rst:34
msgid ""
"Path of raw perf data created by Linux perf tool (it should be profiled with "
"-b)."
msgstr ""

#: ../../../CommandGuide/llvm-profgen.rst:39
msgid ""
"Path of the unsymbolized profile created by ``llvm-profgen`` with ``--skip-"
"symbolization``."
msgstr ""

#: ../../../CommandGuide/llvm-profgen.rst:44
msgid "Path of the LLVM sample profile."
msgstr ""

#: ../../../CommandGuide/llvm-profgen.rst:48
msgid ""
"Only one of ``--perfscript``, ``--perfdata``, ``--unsymbolized-profile``, "
"``--llvm-sample-profile``, or ``--etm`` may be specified at a time."
msgstr ""

#: ../../../CommandGuide/llvm-profgen.rst:53
msgid "Path of the input profiled binary files."
msgstr ""

#: ../../../CommandGuide/llvm-profgen.rst:57
#: ../../../CommandGuide/llvm-profgen.rst:99
msgid "Path of the output profile file."
msgstr ""

#: ../../../CommandGuide/llvm-profgen.rst:61
msgid "OPTIONS"
msgstr ""

#: ../../../CommandGuide/llvm-profgen.rst:62
msgid ":program:`llvm-profgen` supports the following options:"
msgstr ""

#: ../../../CommandGuide/llvm-profgen.rst:66
msgid ""
"Specify the format of the generated profile. Supported <format>  are `text`, "
"`binary`, `extbinary`, `compbinary`, `gcc`, see `llvm-profdata` for more "
"descriptions of the format."
msgstr ""

#: ../../../CommandGuide/llvm-profgen.rst:72
msgid "Print mmap events."
msgstr ""

#: ../../../CommandGuide/llvm-profgen.rst:76
msgid "Print disassembled code."
msgstr ""

#: ../../../CommandGuide/llvm-profgen.rst:80
msgid ""
"Specify whether to print assembly code in AT&T syntax (the default) or Intel "
"syntax."
msgstr ""

#: ../../../CommandGuide/llvm-profgen.rst:85
msgid ""
"Path of debug info binary. ``llvm-profgen`` will load the DWARF info from it "
"instead of the executable binary."
msgstr ""

#: ../../../CommandGuide/llvm-profgen.rst:90
msgid ""
"Override the target triple for the binary. This is useful for ETM trace "
"decoding to specify the correct Arm M-profile target."
msgstr ""

#: ../../../CommandGuide/llvm-profgen.rst:95
msgid "Process Id for the profiled executable binary."
msgstr ""

#: ../../../CommandGuide/llvm-profgen.rst:103
msgid ""
"File path of a Linux perf raw trace (generated by ``perf report -D``) "
"consisting of memory access events."
msgstr ""
