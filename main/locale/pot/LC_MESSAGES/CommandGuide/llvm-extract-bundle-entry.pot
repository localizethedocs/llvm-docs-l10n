#: ../../../CommandGuide/llvm-extract-bundle-entry.md:1
msgid "llvm-extract-bundle-entry - extract an offload bundle entry"
msgstr ""

#: ../../../CommandGuide/llvm-extract-bundle-entry.md:6
msgid "SYNOPSIS"
msgstr ""

#: ../../../CommandGuide/llvm-extract-bundle-entry.md:8
msgid "{program}`llvm-extract-bundle-entry` \\[*options*\\] URI"
msgstr ""

#: ../../../CommandGuide/llvm-extract-bundle-entry.md:10
msgid "DESCRIPTION"
msgstr ""

#: ../../../CommandGuide/llvm-extract-bundle-entry.md:12
msgid ""
"{program}`llvm-extract-offload-entry` is a tool thet takes a URI argument "
"and generates a code object file by extracting an offload bundle entry "
"specified by the URI given."
msgstr ""

#: ../../../CommandGuide/llvm-extract-bundle-entry.md:16
msgid "The URI syntax is defined as:"
msgstr ""

#: ../../../CommandGuide/llvm-extract-bundle-entry.md:28
msgid ""
"The output is always written to a file, whose name is generated from the URI "
"input given."
msgstr ""

#: ../../../CommandGuide/llvm-extract-bundle-entry.md:30
msgid "OPTIONS"
msgstr ""

#: ../../../CommandGuide/llvm-extract-bundle-entry.md:32
msgid ""
"The following options are either agnostic of the file format or apply to "
"multiple file formats."
msgstr ""

#: ../../../CommandGuide/llvm-extract-bundle-entry.md:36
msgid "Print a summary of command line options."
msgstr ""

#: ../../../CommandGuide/llvm-extract-bundle-entry.md:40
msgid ""
"Write output to \\<file>. Multiple input files cannot be used in combination "
"with -o."
msgstr ""

#: ../../../CommandGuide/llvm-extract-bundle-entry.md:45
msgid ""
"Display the version of the {program}`llvm-extract-bundle-entry` executable."
msgstr ""

#: ../../../CommandGuide/llvm-extract-bundle-entry.md:48
msgid "EXIT STATUS"
msgstr ""

#: ../../../CommandGuide/llvm-extract-bundle-entry.md:50
msgid ""
"{program}`llvm-extract-bundle-entry` exits with a non-zero exit code if "
"there is an error. Otherwise, it exits with code 0."
msgstr ""

