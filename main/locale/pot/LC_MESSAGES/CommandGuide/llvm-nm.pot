msgid "Don't demangle symbol names. This is the default."
msgstr ""

#: ../../../CommandGuide/llvm-nm.md:209
msgid "Disable the LLVM bitcode reader."
msgstr ""

#: ../../../CommandGuide/llvm-nm.md:213
