msgid "Print just the symbol names. Alias for `` --format=just-symbols` ``."
msgstr ""

#: ../../../CommandGuide/llvm-nm.md:195
msgid ""
"Use debugging information to print the filenames and line numbers where "
"symbols are defined. Undefined symbols have the location of their first "
"relocation printed instead."
msgstr ""

#: ../../../CommandGuide/llvm-nm.md:201
msgid "Use Darwin format. Alias for `--format=darwin`."
msgstr ""

