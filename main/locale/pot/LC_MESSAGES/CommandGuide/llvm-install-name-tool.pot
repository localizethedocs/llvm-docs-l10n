#: ../../../CommandGuide/llvm-install-name-tool.md:1
msgid ""
"llvm-install-name-tool - LLVM tool for manipulating install-names and rpaths"
msgstr ""

#: ../../../CommandGuide/llvm-install-name-tool.md:6
msgid "SYNOPSIS"
msgstr ""

#: ../../../CommandGuide/llvm-install-name-tool.md:8
msgid "{program}`llvm-install-name-tool` \\[*options*\\] *input*"
msgstr ""

#: ../../../CommandGuide/llvm-install-name-tool.md:10
msgid "DESCRIPTION"
msgstr ""

#: ../../../CommandGuide/llvm-install-name-tool.md:12
msgid ""
"{program}`llvm-install-name-tool` is a tool to manipulate dynamic shared "
"library install names and rpaths listed in a Mach-O binary."
msgstr ""

#: ../../../CommandGuide/llvm-install-name-tool.md:15
msgid ""
"For most scenarios, it works as a drop-in replacement for Apple's {program}"
"`install_name_tool`."
msgstr ""

#: ../../../CommandGuide/llvm-install-name-tool.md:18
msgid "OPTIONS"
msgstr ""

#: ../../../CommandGuide/llvm-install-name-tool.md:20
msgid ""
"At least one of the following options are required, and some options can be "
"combined with other options. Options {option}`-add_rpath`, {option}`-"
"delete_rpath`, and {option}`-rpath` can be combined in an invocation only if "
"they do not share the same `<rpath>` value."
msgstr ""

#: ../../../CommandGuide/llvm-install-name-tool.md:26
msgid ""
"Add an rpath named `<rpath>` to the specified binary. Can be specified "
"multiple times to add multiple rpaths. Throws an error if `<rpath>` is "
"already listed in the binary."
msgstr ""

#: ../../../CommandGuide/llvm-install-name-tool.md:32
msgid ""
"Change an install name `<old_install_name>` to `<new_install_name>` in the "
"specified binary. Can be specified multiple times to change multiple "
"dependent shared library install names. Option is ignored if "
"`<old_install_name>` is not listed in the specified binary."
msgstr ""

#: ../../../CommandGuide/llvm-install-name-tool.md:39
msgid ""
"Delete an rpath named `<rpath>` from the specified binary. Can be specified "
"multiple times to delete multiple rpaths. Throws an error if `<rpath>` is "
"not listed in the binary."
msgstr ""

#: ../../../CommandGuide/llvm-install-name-tool.md:45
msgid "Deletes all rpaths from the binary."
msgstr ""

#: ../../../CommandGuide/llvm-install-name-tool.md:49
msgid "Print a summary of command line options."
msgstr ""

#: ../../../CommandGuide/llvm-install-name-tool.md:53
msgid ""
"Change shared library's identification name under LC_ID_DYLIB to `<name>` in "
"the specified binary. If specified multiple times, only the last {option}`-"
"id` option is selected. Option is ignored if the specified Mach-O binary is "
"not a dynamic shared library."
msgstr ""

#: ../../../CommandGuide/llvm-install-name-tool.md:59
msgid ""
"Write the modified binary to `<file>` instead of updating the input file in "
"place."
msgstr ""

#: ../../../CommandGuide/llvm-install-name-tool.md:63
msgid ""
"Change an rpath named `<old_rpath>` to `<new_rpath>` in the specified "
"binary. Can be specified multiple times to change multiple rpaths. Throws an "
"error if `<old_rpath>` is not listed in the binary or `<new_rpath>` is "
"already listed in the binary."
msgstr ""

#: ../../../CommandGuide/llvm-install-name-tool.md:69
msgid ""
"Display the version of the {program}`llvm-install-name-tool` executable."
msgstr ""

#: ../../../CommandGuide/llvm-install-name-tool.md:72
msgid "EXIT STATUS"
msgstr ""

#: ../../../CommandGuide/llvm-install-name-tool.md:74
msgid ""
"{program}`llvm-install-name-tool` exits with a non-zero exit code if there "
"is an error. Otherwise, it exits with code 0."
msgstr ""

#: ../../../CommandGuide/llvm-install-name-tool.md:77
msgid "BUGS"
msgstr ""

