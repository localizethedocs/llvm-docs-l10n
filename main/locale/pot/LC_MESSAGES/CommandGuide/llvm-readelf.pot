#: ../../../CommandGuide/llvm-readelf.md:1
msgid "llvm-readelf - GNU-style LLVM Object Reader"
msgstr ""

#: ../../../CommandGuide/llvm-readelf.md:6
msgid "SYNOPSIS"
msgstr ""

#: ../../../CommandGuide/llvm-readelf.md:8
msgid "{program}`llvm-readelf` \\[*options*\\] \\[*input...*\\]"
msgstr ""

#: ../../../CommandGuide/llvm-readelf.md:10
msgid "DESCRIPTION"
msgstr ""

#: ../../../CommandGuide/llvm-readelf.md:12
msgid ""
"The {program}`llvm-readelf` tool displays low-level format-specific "
"information about one or more object files."
msgstr ""

#: ../../../CommandGuide/llvm-readelf.md:15
msgid ""
"If `input` is \"`-`\", {program}`llvm-readelf` reads from standard input. "
"Otherwise, it will read from the specified `filenames`."
msgstr ""

#: ../../../CommandGuide/llvm-readelf.md:18
msgid "OPTIONS"
msgstr ""

#: ../../../CommandGuide/llvm-readelf.md:21
msgid "Display the address-significance table."
msgstr ""

#: ../../../CommandGuide/llvm-readelf.md:26
msgid ""
"Equivalent to specifying all the main display options relevant to the file "
"format."
msgstr ""

#: ../../../CommandGuide/llvm-readelf.md:31
msgid ""
"Display architecture-specific information, e.g. the ARM attributes section "
"on ARM."
msgstr ""

#: ../../../CommandGuide/llvm-readelf.md:35
msgid ""
"Display the contents of the basic block address map section(s), which "
"contain the address of each function, along with the relative offset of each "
"basic block."
msgstr ""

#: ../../../CommandGuide/llvm-readelf.md:40
msgid ""
"Display the call graph section entries i.e. for each function its "
"identifying information, each of its direct callees' information and for "
"each indirect callee a 64-bit number representing the callee's function "
"signature. This information can be used to reconstruct the program call "
"graph."
msgstr ""

#: ../../../CommandGuide/llvm-readelf.md:48
msgid "Display the callgraph profile section."
msgstr ""

#: ../../../CommandGuide/llvm-readelf.md:52
msgid ""
"Dump decompressed section content when used with `-x` or `-p`. If the "
"section(s) are not compressed, they are displayed as is."
msgstr ""

#: ../../../CommandGuide/llvm-readelf.md:57
msgid "Display demangled symbol names in the output."
msgstr ""

#: ../../../CommandGuide/llvm-readelf.md:61
msgid "Display the dependent libraries section."
msgstr ""

#: ../../../CommandGuide/llvm-readelf.md:65
msgid "Display the dynamic table."
msgstr ""

#: ../../../CommandGuide/llvm-readelf.md:69
msgid "Display the dynamic relocation entries."
msgstr ""

#: ../../../CommandGuide/llvm-readelf.md:73
msgid "Display the dynamic symbol table."
msgstr ""

#: ../../../CommandGuide/llvm-readelf.md:77
msgid "Display the linker options section."
msgstr ""

#: ../../../CommandGuide/llvm-readelf.md:81
msgid ""
"Format ELF information in the specified style. Valid options are `LLVM`, "
"`GNU`, and `JSON`. `LLVM` output is an expanded and structured format. `GNU` "
"(the default) output mimics the equivalent GNU {program}`readelf` output. "
"`JSON` is JSON formatted output intended for machine consumption."
msgstr ""

#: ../../../CommandGuide/llvm-readelf.md:88
msgid "Display extra information (section name) when showing symbols."
msgstr ""

#: ../../../CommandGuide/llvm-readelf.md:92
msgid ""
"When used with {option}`--relocations`, display each relocation in an "
"expanded multi-line format."
msgstr ""

#: ../../../CommandGuide/llvm-readelf.md:97
msgid "Display file headers."
msgstr ""

#: ../../../CommandGuide/llvm-readelf.md:101
msgid "Display the GNU hash table for dynamic symbols."
msgstr ""

#: ../../../CommandGuide/llvm-readelf.md:105
msgid "Display the expanded hash table with dynamic symbol data."
msgstr ""

#: ../../../CommandGuide/llvm-readelf.md:109
msgid "Display the hash table for dynamic symbols."
msgstr ""

#: ../../../CommandGuide/llvm-readelf.md:113
msgid ""
"Equivalent to setting: {option}`--file-header`, {option}`--program-headers`, "
"and {option}`--sections`."
msgstr ""

#: ../../../CommandGuide/llvm-readelf.md:118
msgid "Display a summary of command line options."
msgstr ""

#: ../../../CommandGuide/llvm-readelf.md:122
msgid ""
"Display the specified section(s) as hexadecimal bytes. `section` may be a "
"section index or section name."
msgstr ""

#: ../../../CommandGuide/llvm-readelf.md:127
msgid "Display a bucket list histogram for dynamic symbol hash tables."
msgstr ""

#: ../../../CommandGuide/llvm-readelf.md:131
msgid ""
"Display information about memory tagging present in the binary. This "
"includes various memtag-specific dynamic entries, decoded global descriptor "
"sections, and decoded Android-specific ELF notes."
msgstr ""

#: ../../../CommandGuide/llvm-readelf.md:137
msgid "Display the needed libraries."
msgstr ""

#: ../../../CommandGuide/llvm-readelf.md:141
msgid "Do not display demangled symbol names in the output. On by default."
msgstr ""

#: ../../../CommandGuide/llvm-readelf.md:145
msgid "Display all notes."
msgstr ""

#: ../../../CommandGuide/llvm-readelf.md:149
msgid "Display list of HIP offload bundles."
msgstr ""

#: ../../../CommandGuide/llvm-readelf.md:153
msgid ""
"When used with {option}`--elf-output-style`, JSON output will be formatted "
"in a more readable format."
msgstr ""

#: ../../../CommandGuide/llvm-readelf.md:158
msgid "Display the program headers."
msgstr ""

#: ../../../CommandGuide/llvm-readelf.md:162
msgid "Display the relocation entries in the file."
msgstr ""

#: ../../../CommandGuide/llvm-readelf.md:166
msgid ""
"When used with {option}`--sections`, display section data for each section "
"shown. This option has no effect for GNU style output."
msgstr ""

#: ../../../CommandGuide/llvm-readelf.md:171
msgid ""
"Display all section details. Used as an alternative to {option}`--sections`."
msgstr ""

#: ../../../CommandGuide/llvm-readelf.md:175
msgid "Display section groups."
msgstr ""

#: ../../../CommandGuide/llvm-readelf.md:179
msgid "Display the section to segment mapping."
msgstr ""

#: ../../../CommandGuide/llvm-readelf.md:183
msgid ""
"When used with {option}`--sections`, display relocations for each section "
"shown. This option has no effect for GNU style output."
msgstr ""

#: ../../../CommandGuide/llvm-readelf.md:188
msgid "Display all sections."
msgstr ""

#: ../../../CommandGuide/llvm-readelf.md:192
msgid ""
"When used with {option}`--sections`, display symbols for each section shown. "
"This option has no effect for GNU style output."
msgstr ""

#: ../../../CommandGuide/llvm-readelf.md:197
msgid "Display contents of the stackmap section."
msgstr ""

#: ../../../CommandGuide/llvm-readelf.md:201
msgid ""
"Display the contents of the stack sizes section(s), i.e. pairs of function "
"names and the size of their stack frames. Currently only implemented for GNU "
"style output."
msgstr ""

#: ../../../CommandGuide/llvm-readelf.md:207
msgid ""
"Display the specified section(s) as a list of strings. `section` may be a "
"section index or section name."
msgstr ""

#: ../../../CommandGuide/llvm-readelf.md:212
msgid ""
"Display the symbol table. Also display the dynamic symbol table when using "
"GNU output style for ELF."
msgstr ""

#: ../../../CommandGuide/llvm-readelf.md:216
msgid "Display unwind information."
msgstr ""

#: ../../../CommandGuide/llvm-readelf.md:220
msgid "Display the version of the {program}`llvm-readelf` executable."
msgstr ""

#: ../../../CommandGuide/llvm-readelf.md:224
msgid "Display version sections."
msgstr ""

#: ../../../CommandGuide/llvm-readelf.md:228
msgid ""
"Ignored for GNU readelf compatibility. The output is already similar to when "
"using -W with GNU readelf."
msgstr ""

#: ../../../CommandGuide/llvm-readelf.md:232
msgid "Read command-line options from response file `<FILE>`."
msgstr ""

#: ../../../CommandGuide/llvm-readelf.md:235
msgid "EXIT STATUS"
msgstr ""

#: ../../../CommandGuide/llvm-readelf.md:237
msgid ""
"{program}`llvm-readelf` returns 0 under normal operation. It returns a non-"
"zero exit code if there were any errors."
msgstr ""

#: ../../../CommandGuide/llvm-readelf.md:240
msgid "SEE ALSO"
msgstr ""

#: ../../../CommandGuide/llvm-readelf.md:242
msgid ""
"{manpage}`llvm-nm(1)`, {manpage}`llvm-objdump(1)`, {manpage}`llvm-readobj(1)`"
msgstr ""
