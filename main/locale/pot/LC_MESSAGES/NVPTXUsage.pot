msgid "{5, 4, 3, 2}"
msgstr ""

#: ../../../NVPTXUsage.md:1589
msgid "{6, 5, 4, 3}"
msgstr ""

#: ../../../NVPTXUsage.md:1591
msgid "``b4e``"
msgstr ""

#: ../../../NVPTXUsage.md:1591
msgid "{5, 6, 7, 0}"
msgstr ""

#: ../../../NVPTXUsage.md:1593
msgid "{6, 7, 0, 1}"
msgstr ""

#: ../../../NVPTXUsage.md:1595
msgid "{7, 0, 1, 2}"
msgstr ""

#: ../../../NVPTXUsage.md:1597
msgid "{0, 1, 2, 3}"
msgstr ""

#: ../../../NVPTXUsage.md:1599
msgid "``rc8``"
msgstr ""

#: ../../../NVPTXUsage.md:1599 ../../../NVPTXUsage.md:1615
msgid "{0, 0, 0, 0}"
msgstr ""

#: ../../../NVPTXUsage.md:1601
msgid "{1, 1, 1, 1}"
msgstr ""

#: ../../../NVPTXUsage.md:1603
msgid "{2, 2, 2, 2}"
msgstr ""

#: ../../../NVPTXUsage.md:1605 ../../../NVPTXUsage.md:1613
msgid "{3, 3, 3, 3}"
msgstr ""

#: ../../../NVPTXUsage.md:1607
msgid "``ecl``"
msgstr ""

#: ../../../NVPTXUsage.md:1609
msgid "{3, 2, 1, 1}"
msgstr ""

#: ../../../NVPTXUsage.md:1611
msgid "{3, 2, 2, 2}"
msgstr ""

#: ../../../NVPTXUsage.md:1615
msgid "``ecr``"
msgstr ""

#: ../../../NVPTXUsage.md:1617
msgid "{1, 1, 1, 0}"
msgstr ""

#: ../../../NVPTXUsage.md:1619
msgid "{2, 2, 1, 0}"
msgstr ""

#: ../../../NVPTXUsage.md:1623
msgid "``rc16``"
msgstr ""

#: ../../../NVPTXUsage.md:1623 ../../../NVPTXUsage.md:1627
