#: ../../../NVPTXUsage.md:2892
msgid ""
"'`llvm.nvvm.cp.async.bulk.tensor.g2s.im2col*.override.addr.[3-5]d`' "
"Intrinsics"
msgstr ""

#: ../../../NVPTXUsage.md:2915
