msgstr ""

#: ../../../NVPTXUsage.md:1006
msgid "`add`"
msgstr ""

#: ../../../NVPTXUsage.md:1006
msgid "`min`"
msgstr ""

#: ../../../NVPTXUsage.md:1006
msgid "`max`"
msgstr ""

#: ../../../NVPTXUsage.md:1006
msgid "`inc`"
msgstr ""

