#: ../../../NVPTXUsage.md:3379
msgid "'`llvm.nvvm.tensormap.replace.global.dim`'"
msgstr ""

#: ../../../NVPTXUsage.md:3390
msgid ""
"The '`@llvm.nvvm.tensormap.replace.global.dim.*`' intrinsics replace the "
"`%ord`-th element of the `global_dim` field of the tensor-map object with "
"`%new_value`. `%ord` must be in the range [0, 4]."
msgstr ""

#: ../../../NVPTXUsage.md:3394
msgid "'`llvm.nvvm.tensormap.replace.box.dim`'"
msgstr ""

#: ../../../NVPTXUsage.md:3405
msgid ""
"The '`@llvm.nvvm.tensormap.replace.box.dim.*`' intrinsics replace the `%ord`-"
