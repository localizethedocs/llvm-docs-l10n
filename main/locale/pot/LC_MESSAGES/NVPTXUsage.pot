#: ../../../NVPTXUsage.md:2767
msgid "'`llvm.nvvm.cp.async.bulk.tensor.reduce.im2col.override.addr.[3-5]d`'"
msgstr ""

#: ../../../NVPTXUsage.md:2779
msgid ""
"The '`@llvm.nvvm.cp.async.bulk.tensor.reduce.im2col.override.addr.[3-5]d`' "
"intrinsics correspond to the `cp.reduce.async.bulk.tensor.im2col_no_offs."
"[3-5]d.global.shared::cta.*` set of PTX instructions qualified with the `."
