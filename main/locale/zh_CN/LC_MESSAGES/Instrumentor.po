#: ../../../Instrumentor.rst:45
msgid ""
"**Load instructions**: Instrument memory reads with access to pointer, "
"loaded value, alignment, size, atomicity, etc."
msgstr ""

#: ../../../Instrumentor.rst:46
msgid ""
"**Store instructions**: Instrument memory writes with access to pointer, "
"stored value, alignment, size, atomicity, etc."
msgstr ""

#: ../../../Instrumentor.rst:47
msgid ""
"**Alloca instructions**: Instrument stack allocations with access to size, "
"alignment, and allocated address"
msgstr ""

#: ../../../Instrumentor.rst:51
msgid "**Function-level:**"
msgstr ""

#: ../../../Instrumentor.rst:50
msgid ""
"**Function entry**: Instrument at function start with access to function "
"name, address, arguments, etc."
msgstr ""

#: ../../../Instrumentor.rst:51
msgid "**Function exit**: Instrument at function return"
msgstr ""

#: ../../../Instrumentor.rst:56
msgid "**Future extensions:**"
msgstr ""

#: ../../../Instrumentor.rst:54 ../../../Instrumentor.rst:901
msgid "Basic block entry/exit"
msgstr ""

