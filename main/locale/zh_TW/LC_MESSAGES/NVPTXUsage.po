msgstr ""

#: ../../../NVPTXUsage.rst:2244
msgid "'``llvm.nvvm.cp.async.bulk.tensor.s2g.tile.[1-5]d``'"
msgstr ""

#: ../../../NVPTXUsage.rst:2262
msgid ""
"The '``@llvm.nvvm.cp.async.bulk.tensor.s2g.tile.[1-5]d``' intrinsics "
"correspond to the ``cp.async.bulk.tensor.[1-5]d.*`` set of PTX instructions. "
