msgid ""
"Casts where the target type is already spelled out on the right-hand side "
"(``cast``, ``dyn_cast``, ``static_cast``, etc.):"
msgstr ""

#: ../../../AMDGPU/DeveloperGuideline.rst:54
msgid "Iterators:"
msgstr ""

#: ../../../AMDGPU/DeveloperGuideline.rst:60
msgid "Structured bindings:"
msgstr ""

#: ../../../AMDGPU/DeveloperGuideline.rst:66
msgid "In all other cases, write the type explicitly."
