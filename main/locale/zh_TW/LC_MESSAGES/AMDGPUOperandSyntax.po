#: ../../../AMDGPUOperandSyntax.md:652
msgid "\\<S> = \\<E>"
msgstr ""

#: ../../../AMDGPUOperandSyntax.md:652
msgid "\\<S>:"
msgstr ""

#: ../../../AMDGPUOperandSyntax.md:652
msgid "Declares a label S and assigns it the current PC value."
msgstr ""

#: ../../../AMDGPUOperandSyntax.md:962
msgid ""
"A symbol may be used before it is declared or assigned; unassigned symbols "
