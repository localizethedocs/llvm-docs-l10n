#: ../../../AMDGPUInstructionNotation.md:1
msgid "AMDGPU Instructions Notation"
msgstr ""

#: ../../../AMDGPUInstructionNotation.md:5
msgid "Introduction"
msgstr ""

#: ../../../AMDGPUInstructionNotation.md:7
msgid ""
"This is an overview of notation used to describe the syntax of AMDGPU "
"assembler instructions."
msgstr ""

#: ../../../AMDGPUInstructionNotation.md:9
msgid ""
"This notation looks a lot like the {ref}`syntax of assembler "
"instructions<amdgpu_syn_instructions>`, except that instead of real operands "
"and modifiers, it uses references to their descriptions."
msgstr ""

#: ../../../AMDGPUInstructionNotation.md:12
msgid "Instructions"
msgstr ""

#: ../../../AMDGPUInstructionNotation.md:14
#: ../../../AMDGPUInstructionNotation.md:24
#: ../../../AMDGPUInstructionNotation.md:41
#: ../../../AMDGPUInstructionNotation.md:106
msgid "Notation"
msgstr ""

#: ../../../AMDGPUInstructionNotation.md:16
msgid "This is the notation used to describe AMDGPU instructions:"
msgstr ""

#: ../../../AMDGPUInstructionNotation.md:18
msgid ""
"\\<{ref}`opcode description <amdgpu_syn_opcode_notation>`\\> \\<{ref}"
"`operands description <amdgpu_syn_instruction_operands_notation>`\\> \\<{ref}"
"`modifiers description <amdgpu_syn_instruction_modifiers_notation>`\\>"
msgstr ""

#: ../../../AMDGPUInstructionNotation.md:22
msgid "Opcode"
msgstr ""

#: ../../../AMDGPUInstructionNotation.md:26
msgid "TBD"
msgstr ""

#: ../../../AMDGPUInstructionNotation.md:30
msgid "Operands"
msgstr ""

#: ../../../AMDGPUInstructionNotation.md:32
msgid ""
"An instruction may have zero or more *operands*. They are comma-separated in "
"the description:"
msgstr ""

#: ../../../AMDGPUInstructionNotation.md:34
msgid ""
"\\<{ref}`description of operand 0 "
"<amdgpu_syn_instruction_operand_notation>`\\>, \\<{ref}`description of "
"operand 1 <amdgpu_syn_instruction_operand_notation>`\\>, `...`"
msgstr ""

#: ../../../AMDGPUInstructionNotation.md:36
msgid ""
"The order of *operands* is fixed. *Operands* cannot be omitted except for "
"special cases described below."
msgstr ""

#: ../../../AMDGPUInstructionNotation.md:43
msgid "An operand is described using the following notation:"
msgstr ""

#: ../../../AMDGPUInstructionNotation.md:45
msgid "*\\<kind>\\<name>\\<tag0>\\<tag1>...*"
msgstr ""

#: ../../../AMDGPUInstructionNotation.md:47
msgid "Where:"
msgstr ""

#: ../../../AMDGPUInstructionNotation.md:49
msgid ""
"*kind* is an optional prefix describing operand {ref}"
"`kind<amdgpu_syn_instruction_operand_kinds>`."
msgstr ""

#: ../../../AMDGPUInstructionNotation.md:50
msgid "*name* is a link to a description of the operand."
msgstr ""

#: ../../../AMDGPUInstructionNotation.md:51
msgid ""
"*tags* are optional. They are used to indicate {ref}`special operand "
"properties<amdgpu_syn_instruction_operand_tags>`."
msgstr ""

#: ../../../AMDGPUInstructionNotation.md:56
msgid "Operand Kinds"
msgstr ""

#: ../../../AMDGPUInstructionNotation.md:58
msgid "Operand kind indicates which values are accepted by the operand."
msgstr ""

#: ../../../AMDGPUInstructionNotation.md:60
msgid ""
"Operands which only accept *vector* registers are labelled with 'v' prefix."
msgstr ""

#: ../../../AMDGPUInstructionNotation.md:61
msgid ""
"Operands which only accept *scalar* registers and values are labelled with "
"'s' prefix."
msgstr ""

#: ../../../AMDGPUInstructionNotation.md:62
msgid "Operands which accept any registers and values have no prefix."
msgstr ""

#: ../../../AMDGPUInstructionNotation.md:64
#: ../../../AMDGPUInstructionNotation.md:86
msgid "Examples:"
msgstr ""

#: ../../../AMDGPUInstructionNotation.md:74
msgid "Operand Tags"
msgstr ""

#: ../../../AMDGPUInstructionNotation.md:76
msgid "Operand tags indicate special operand properties."
msgstr ""

#: ../../../AMDGPUInstructionNotation.md:0
msgid "Operand tag"
msgstr ""

#: ../../../AMDGPUInstructionNotation.md:0
msgid "Meaning"
msgstr ""

#: ../../../AMDGPUInstructionNotation.md:0
msgid ":opt"
msgstr ""

#: ../../../AMDGPUInstructionNotation.md:0
msgid "An optional operand."
msgstr ""

#: ../../../AMDGPUInstructionNotation.md:0
msgid ":m"
msgstr ""

#: ../../../AMDGPUInstructionNotation.md:0
msgid ""
"An operand which may be used with operand modifiers {ref}"
"`abs<amdgpu_synid_abs>`, {ref}`neg<amdgpu_synid_neg>` or {ref}"
"`sext<amdgpu_synid_sext>`."
msgstr ""

#: ../../../AMDGPUInstructionNotation.md:0
msgid ":dst"
msgstr ""

#: ../../../AMDGPUInstructionNotation.md:0
msgid ""
"An input operand which is also used as a destination if {ref}"
"`glc<amdgpu_synid_glc>` modifier is specified."
msgstr ""

#: ../../../AMDGPUInstructionNotation.md:0
msgid ":fx"
msgstr ""

#: ../../../AMDGPUInstructionNotation.md:0
msgid ""
"This is a *f32* or *f16* operand, depending on {ref}"
"`m_op_sel_hi<amdgpu_synid_mad_mix_op_sel_hi>` modifier."
msgstr ""

#: ../../../AMDGPUInstructionNotation.md:0
msgid ":\\<type>"
msgstr ""

#: ../../../AMDGPUInstructionNotation.md:0
msgid ""
"The operand *type* differs from the *type* {ref}`implied by the opcode "
"name<amdgpu_syn_instruction_type>`. This tag specifies the actual operand "
"*type*."
msgstr ""

#: ../../../AMDGPUInstructionNotation.md:96
msgid "Modifiers"
msgstr ""

#: ../../../AMDGPUInstructionNotation.md:98
msgid ""
"An instruction may have zero or more optional *modifiers*. They are space-"
"separated in the description:"
msgstr ""

#: ../../../AMDGPUInstructionNotation.md:100
msgid ""
"\\<{ref}`description of modifier 0 "
"<amdgpu_syn_instruction_modifier_notation>`\\> \\<{ref}`description of "
"modifier 1 <amdgpu_syn_instruction_modifier_notation>`\\> `...`"
msgstr ""

#: ../../../AMDGPUInstructionNotation.md:102
msgid "The order of *modifiers* is fixed."
msgstr ""

#: ../../../AMDGPUInstructionNotation.md:108
msgid "A *modifier* is described using the following notation:"
msgstr ""

#: ../../../AMDGPUInstructionNotation.md:110
msgid "*\\<name>*"
msgstr ""

#: ../../../AMDGPUInstructionNotation.md:112
msgid "Where the *name* is a link to a description of the *modifier*."
msgstr ""
